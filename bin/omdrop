#!/usr/bin/env bash
# omdrop -- send and receive files with nearby Apple devices.
#
# "omdrop" is this project's name for the feature. The protocol it speaks is
# Apple's, and its wire identifiers are not ours to rename: the mDNS service
# type really is _airdrop._tcp, the endpoints really are /Discover, /Ask and
# /Upload, and the receiver's config key really is ReceiverComputerName. So
# everything below the user-facing surface still says airdrop, deliberately --
# airdrop-serve.py, airdrop-receiver.service and ~/.config/airdrop/config.toml
# are protocol- and service-layer names, not product ones.
#
# This command owns the receive-window duration and receiver configuration
# that do not belong in the panel.
#
# The panel holds no state of its own. It shells out to this command for every
# action (toggle, peers --json, send --pick, dir --pick, sound) and reads
# `omdrop status --json`; everything with an argument lives here.
#
# This wraps what already exists rather than inventing state:
#   receiving on/off   systemctl --user airdrop-receiver.service
#   the window         a transient systemd timer that stops that unit
#   name / model / directory / limit
#                    ~/.config/airdrop/config.toml, read by airdrop-serve.py
# There is no daemon of our own and no state file. `status` asks systemd, so
# it stays right when the service dies, the timer fires, or someone runs
# systemctl by hand.
#
# The receiver validates config.toml and refuses to start on a bad value --
# that is deliberate (airdrop-serve.py:44). The check in `name` below is a
# courtesy so a typo fails here with a readable message instead of at the next
# start; the receiver remains the gate, and a set that the receiver rejects is
# rolled back.
#
# Install:  ln -s "$PWD/tools/omdrop" ~/.local/bin/omdrop
# The unit itself is not enabled by default; see the header of
# packaging/systemd/airdrop-receiver.service.
set -uo pipefail

UNIT=airdrop-receiver.service
WINDOW=omdrop-window           # transient .timer that closes the window
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/airdrop/config.toml"
SELF="$(readlink -f "$0")"
PROJ="$(cd "$(dirname "$SELF")/.." && pwd)"

# Whether version $1 is $2 or newer. pacman's vercmp where it exists, which
# also orders pkgrel and epoch; otherwise coreutils' sort -V, which every
# distribution has and which orders plain dotted versions, such as the
# contract a backend reports, the same way once leading zeros are gone
# (vercmp reads 0.07.0 as 0.7.0; sort -V breaks that tie on the text).
# Anything else is not taken as newer there: sort -V would put "abc" after
# "0.7.0", where vercmp puts it before. Debian and Ubuntu have no vercmp, and
# a bare $(vercmp ...) there is an arithmetic syntax error that reads as "not
# older".
version_ge() {
  if command -v vercmp >/dev/null 2>&1; then
    (( $(vercmp "$1" "$2") >= 0 ))
  else
    [[ "$1" =~ ^[0-9]+(\.[0-9]+)*(-[0-9]+(\.[0-9]+)*)?$ ]] || return 1
    local have want
    have=$(sed -E 's/(^|[.-])0+([0-9])/\1\2/g' <<<"$1")
    want=$(sed -E 's/(^|[.-])0+([0-9])/\1\2/g' <<<"$2")
    [[ "$(printf '%s\n%s\n' "$have" "$want" | sort -V | head -n 1)" == "$want" ]]
  fi
}

# omdrop-core (core/ in this repository) is the same command in Rust, built
# and installed as its own package. Its `omdrop` sits at
# /usr/lib/omdrop-core/omdrop, off PATH, so this file is the one entry point:
# the panel, the PATH link setup makes and the systemd units all run it, and it
# applies CORE_MIN and OMDROP_IMPLEMENTATION before core runs. When a core
# this plugin can use is installed, every command goes to it, and
# `exec -a "$0"` lets core find this plugin through the path we were run as.
# Core moves to /usr/bin/omdrop only once it is offered on every backend that
# ships its hooks (omdrop-owl is not yet) and cores older than this hand-off
# are gone.
# OMDROP_IMPLEMENTATION picks the stack: python keeps this script and the
# Python programs; rust requires a usable core; unset uses core when a usable
# one is installed. Anything else is refused, so a typo cannot quietly pick a
# stack.
# install-core never goes to core, whatever OMDROP_IMPLEMENTATION says: it is
# how core gets installed or updated, and a core older than install-core would
# answer it with its usage. With rust and no core it runs here for the same
# reason. OMDROP_CORE moves the binary for tests. Never hand off to ourselves:
# an OMDROP_CORE that is a link to this file would loop.
#
# CORE_MIN is the oldest core this plugin hands off to. New features land
# only in core/, so a plugin update can rely on a command or flag an older
# core does not have: on Arch until install-core runs, and wherever core comes
# with another package whose pin lags this plugin. Below it, or when its
# version cannot be read, this script and the Python programs run instead and
# doctor says so. The version is core's own (its `version` line, the workspace
# version in core/Cargo.toml), not pacman's, which knows nothing of a core
# installed another way. Asking costs about a millisecond. Raise CORE_MIN, and
# core's pkgver with it, when the plugin starts relying on something newer:
# 0.1.3 pins omdrop-awdl 0.10.0 (install-driver goes to core, so an older core
# would build the older driver), 0.1.4 has #57's HEIC previews and Files
# fallback, which an older core would silently lack, 0.1.7 has Apple's
# renewed Application Integration CA: an older core trusts the copy that
# expired on 2026-10-21 and refuses Contacts Only senders it issued (#75),
# while the Python receiver beside this script has the renewed one, and 0.1.8
# pins omdrop-awdl 0.10.1 and writes one arrival record per file, which this
# plugin's `omdrop watch` and panel expect (#106-#108).
#
# Core also needs a radio backend that ships its hooks (core's
# docs/backend-contract.md): omdrop-awdl from 0.10.0 does, and so does
# omdrop-owl from 0.4.0. Without them this script and the Python programs run.
# Hooks are enough for a core that is already installed to run, but
# core_supported decides where it is offered, and that is only where it has
# been tested: omdrop-awdl so far. The check is one file test. OMDROP_HOOKS
# moves it for tests.
CORE_MIN=0.1.8
CORE_TOO_OLD=
CORE_NO_HOOKS=
core_version() {
  timeout -k 1 2 "$OMDROP_CORE" version </dev/null 2>/dev/null | sed -n 's/^omdrop-core \([^[:space:]]*\)$/\1/p' | head -n 1
}
OMDROP_CORE="${OMDROP_CORE:-/usr/lib/omdrop-core/omdrop}"
OMDROP_HOOKS="${OMDROP_HOOKS:-/usr/lib/omdrop/radio}"

# The panel polls every ten seconds, so a window opened or a setting changed
# from a terminal could show the old state for that long. These commands tell
# it to look again once they finish, whichever implementation ran them, and
# whether they succeeded or not: a failed `on` changes state too. Best effort:
# no Omarchy shell, no panel, or an older panel without `refresh`, and nothing
# happens. `status` is not on the list; the panel's refresh runs it.
changes_panel() {
  case "${1:-}" in
    on|start|off|stop|toggle|name|dir|sound|limit|visibility|vis|viz|senders) return 0 ;;
  esac
  return 1
}
panel_refresh() {
  command -v omarchy-shell >/dev/null 2>&1 || return 0
  timeout -k 1 2 omarchy-shell -q netmojo.omdrop refresh </dev/null >/dev/null 2>&1 || true
}
case "${OMDROP_IMPLEMENTATION:-}" in
  python) ;;
  rust|'')
    if [[ "${1:-}" == install-core ]]; then
      :
    elif [[ -x "$OMDROP_CORE" && "$(readlink -f "$OMDROP_CORE")" != "$SELF" ]]; then
      if [[ ! -x "$OMDROP_HOOKS/probe" ]]; then
        CORE_NO_HOOKS=1
        if [[ -n "${OMDROP_IMPLEMENTATION:-}" ]]; then
          printf 'omdrop: OMDROP_IMPLEMENTATION=rust, but the radio backend installs no omdrop-core hooks in %s.\n' "$OMDROP_HOOKS" >&2
          exit 2
        fi
      else
        CORE_TOO_OLD=$(core_version)
        if [[ -n "$CORE_TOO_OLD" ]] && version_ge "$CORE_TOO_OLD" "$CORE_MIN"; then
          if changes_panel "${1:-}"; then
            # A subshell, so core still sees this script as $0.
            (exec -a "$0" "$OMDROP_CORE" "$@")
            rc=$?
            panel_refresh
            exit "$rc"
          fi
          exec -a "$0" "$OMDROP_CORE" "$@"
        fi
        CORE_TOO_OLD=${CORE_TOO_OLD:-unknown}
        if [[ -n "${OMDROP_IMPLEMENTATION:-}" ]]; then
          printf 'omdrop: OMDROP_IMPLEMENTATION=rust, but the omdrop-core at %s (version %s) is older than the %s this version of Omdrop needs.\n' \
            "$OMDROP_CORE" "$CORE_TOO_OLD" "$CORE_MIN" >&2
          exit 2
        fi
      fi
    elif [[ -n "${OMDROP_IMPLEMENTATION:-}" ]]; then
      printf 'omdrop: OMDROP_IMPLEMENTATION=rust, but omdrop-core is not installed at %s.\n' "$OMDROP_CORE" >&2
      exit 2
    fi ;;
  *)
    printf 'omdrop: OMDROP_IMPLEMENTATION must be python or rust, not "%s"\n' "$OMDROP_IMPLEMENTATION" >&2
    exit 2 ;;
esac

# The version a bug report needs. manifest.json is the single source of truth
# -- the marketplace reads it -- and the constant below is only a last resort.
#
# Resolve $0 before looking for the manifest. Invoked through the
# ~/.local/bin/omdrop symlink that `setup` creates, an unresolved $0 puts the
# search in ~/.local, which holds no manifest, so the constant was printed
# instead. That is how `omdrop version` reported 0.4.1 while the installed
# manifest said 0.4.0 and concealed a stale install.
#
# A fallback that silently substitutes for the real value is the same class of
# defect as a status line reporting a state that was never entered, so this one
# says when it is guessing, and says when the two disagree.
VERSION_FALLBACK=0.18.5
omdrop_version() {
  local dir manifest version= real
  real=$(readlink -f "$0" 2>/dev/null) || real="$0"
  dir=$(cd "$(dirname "$real")/.." 2>/dev/null && pwd) || dir=
  manifest="$dir/manifest.json"
  [[ -n "$dir" && -r "$manifest" ]] \
    && version=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$manifest" | head -1)
  if [[ -z "$version" ]]; then
    printf '%s\n' "$VERSION_FALLBACK"
    printf 'omdrop: could not read a version from %s, so %s is this script only and may not be what is installed.\n' \
      "${manifest:-manifest.json}" "$VERSION_FALLBACK" >&2
    return
  fi
  printf '%s\n' "$version"
  [[ "$version" == "$VERSION_FALLBACK" ]] || \
    printf 'omdrop: the installed manifest says %s but this script is from %s. The install is mismatched; reinstall the plugin.\n' \
      "$version" "$VERSION_FALLBACK" >&2
}

# The radio half: makes us discoverable to Everyone (AWDL _airdrop
# announcements + the BLE wake advert). Owned by the driver side; this CLI
# only calls it. Absent = the receiver still runs and still accepts a transfer
# from a peer that already knows us, but nobody's sheet will show a tile --
# so `on` says that out loud rather than reporting a success it cannot back up.
# Found in this order: an explicit override, anything on PATH, then the
# sibling tools/ directory of a source checkout. The plugin ships this script
# but not the radio half, so "next to me" is exactly where it will not be.
DISCOVERABLE="${OMDROP_DISCOVERABLE:-}"
# The packaged location first: root-owned, covered by the polkit action, and
# the only arrangement fit to ship. A source checkout falls through to PATH.
[[ -n "$DISCOVERABLE" || ! -x /usr/lib/omdrop/omdrop-discoverable ]] \
  || DISCOVERABLE=/usr/lib/omdrop/omdrop-discoverable
if [[ -z "$DISCOVERABLE" ]]; then
  DISCOVERABLE=$(command -v awdl-discoverable 2>/dev/null || true)
fi
[[ -n "$DISCOVERABLE" ]] || DISCOVERABLE="$PROJ/tools/awdl-discoverable"
# Resolve symlinks: the helper re-execs itself under pkexec using $0, and the
# polkit rule matches on the real script path. Invoked through a ~/.local/bin
# symlink it would ask for a password every single time.
[[ -e "$DISCOVERABLE" ]] && DISCOVERABLE=$(readlink -f "$DISCOVERABLE")

# The sending half, found the same way and for the same reason: send-to-peer
# ships with the driver package, not with this plugin, because what it needs
# -- the firmware's peer table -- belongs to the radio side. Absent = `send`
# and `peers` say so and name the command that installs it.
SENDER="${OMDROP_SENDER:-}"
[[ -n "$SENDER" || ! -x /usr/lib/omdrop/send-to-peer ]] \
  || SENDER=/usr/lib/omdrop/send-to-peer
if [[ -z "$SENDER" ]]; then
  SENDER=$(command -v send-to-peer 2>/dev/null || true)
fi
[[ -n "$SENDER" ]] || SENDER="$PROJ/tools/send-to-peer"
# Resolve symlinks here too: send-to-peer finds the radio helper and
# airdrop-send.py beside itself, through __file__, which argparse-era Python
# does not resolve. Invoked through a symlink it would look for both in a
# directory that holds neither.
[[ -e "$SENDER" ]] && SENDER=$(readlink -f "$SENDER")

# Being visible to Everyone is not a state to leave on by accident, so `on`
# is bounded unless you say otherwise. Ten minutes is what iOS uses.
DEFAULT_WINDOW=10m

# An iPhone does not keep an AirDrop listener up while it is merely
# discoverable -- it opens one in short bursts -- so a single attempt at one
# is a coin flip, and the first thing anyone hits is a refused connection. The
# sender polls for the burst instead, and this is how long `send` gives it.
# A Mac in Everyone mode listens throughout and never spends a second of it:
# the poll is skipped entirely when the port is already open.
DEFAULT_SEND_WAIT=30

# The watcher announces every file that lands and, in one-file mode, turns us
# off after the first. There is no separate unit for that mode: `omdrop-once`
# named a .path unit nothing ever created, so `status` -- which inferred the
# mode from it -- called every one-file window "forever", and the panel's
# duration row showed "Until I turn it off" for a window that stops after one
# file. The watcher's own ExecStart carries the truth.
WATCH=omdrop-watch

# The identity commands, and the timer that turns a window off at the 1Password
# cache's hard expiry: a kernel timeout clears the cache, but only stopping the
# receiver clears the copy it loaded. See docs/identity-contract.md.
identity_py() { python3 "$PROJ/bin/identity.py" "$@"; }
ID_PY=identity_py
ID_EXPIRY=omdrop-identity-expiry

# omdrop's own settings live apart from the receiver's config.toml on purpose:
# airdrop-serve.py validates that file against a fixed key list and refuses to
# start on anything it does not recognise, so adding our keys there would stop
# the receiver dead.
SETTINGS="${XDG_CONFIG_HOME:-$HOME/.config}/omdrop/settings"

die() { printf '%s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
omdrop -- send and receive files with nearby Apple devices

  on [-c|-e] [DURATION]
                    become visible to nearby Apple devices and receive files.
                    Stops again after DURATION (default 10m). A bare number
                    is minutes, so "on 3" is three minutes; "10m", "1h" and
                    "30s" also work. "forever" stays on until you turn it
                    off; "once" stops after the first file arrives.
                    -e/--everyone  anyone nearby may send (the default)
                    -c/--contacts  only known senders may send
                    Either flag also sets the saved visibility, so it stays
                    that way until you change it back.
  off [--force]     stop receiving and advertising, cancel any pending window.
                    Refuses while a send is running, since that would cut it
                    off; --force stops anyway
  toggle            off if receiving, on if not
  status [--json]   receiving or not, time left, the name Macs see
  send [NAME] FILE...|URL...
                    send files to a nearby Apple device, as one transfer
                    it accepts once, or send http/https links. A .webloc or
                    .url file holding a web link goes as that link.
                    Send links and files separately. With Omdrop off, a
                    send to NAME turns it on for the usual window first.
                    NAME searches for up to two minutes, reporting devices
                    as they answer; OMDROP_NAME_WAIT sets this in seconds.
                    An exact name wins over a partial match; duplicate names
                    need --to ADDRESS. Cleanup can take two more seconds.
                    --wait SECONDS waits for an iPhone's receiver to wake
                    (default 30), separately from finding its name, announcing
                    this machine over Bluetooth. --pick opens a file chooser.
  peers [-n]        the Apple devices nearby right now. -n also asks
                    each one for its name, which means connecting to it and
                    showing this machine to every device listed, and briefly
                    announcing this Apple ID over Bluetooth so a "Contacts
                    Only" device will answer at all. --no-wake skips the
                    announcement; names then come only from devices that are
                    already listening. --json prints one JSON array
  name [NEW]        show the name, or set it (restarts a running receiver)
  dir [PATH|--pick] show the download folder, or set it (--pick: in a chooser)
  sound [on|off]    the panel's radar sound effects
  limit [PERCENT]   show the maximum transfer size, or set it to 1-90% of
                    currently free space (default 30%)
  visibility [MODE]  show, or set to "everyone" (default) or "contacts".
                     In contacts mode only known senders may send to you.
  senders [add|remove ID | list]
                     manage the known-senders list (emails and phone numbers)
  identity [status|unlock|lock]
                    which identity Apple devices see. With the identity in
                    1Password, `unlock` fetches it now and `lock` turns
                    Omdrop off and clears the cached copy.
  identity 1password import [--vault V] [--title T]
                    move the Apple identity from ~/.omdrop/keys into
                    1Password; the files are deleted only once 1Password
                    holds an identical copy
  identity 1password use ITEM | off
                    use an identity already in 1Password, or stop using it
  setup             install what receiving needs: the service, the name Macs
                    see, this computer's certificate, and the handler that
                    opens received links on double-click. Safe to run again.
  doctor [--json]   what is still missing before this can receive
  install-driver    build and install the Wi-Fi driver, in a terminal you watch
  install-core      install omdrop-core, the Rust version of Omdrop, built from
                    this plugin, in a terminal you watch
  firewall ACTION   install or remove Omdrop's narrow UFW receiver rule
  links ACTION      install or remove the double-click handler for received
                    .url and .webloc links
  open-link FILE    open a .url or .webloc link in the browser (web links only)
  skill ACTION      install or remove the skill that tells AI agents how to
                    use omdrop (nothing else installs it)
  version           the plugin version, for bug reports

Aliases, if you reach for a different word:
  start = on      stop = off      list = peers      vis, viz = visibility

Examples:
  omdrop on 10m
  omdrop on forever
  omdrop send ~/photo.jpg
  omdrop send "Studio Mac" https://omarchy.org/
  omdrop name "Brent's Omarchy"
  omdrop limit 30
EOF
}

have_unit() {
  systemctl --user cat "$UNIT" >/dev/null 2>&1
}

# First use installs what `setup` would. The panel's switch is the first thing
# most people press, and telling them to "Run: omdrop setup" named a command
# that only `setup` itself puts on PATH, so on a fresh install it was not found
# (issue 12).
require_unit() {
  have_unit && return 0
  setup_install || true
  have_unit || die "The service that receives files could not be installed. The reason is above."
}

receiving() {
  [[ "$(systemctl --user is-active "$UNIT" 2>/dev/null)" == active ]]
}

# awdl0 carrying an IPv6 link-local address: the only address AirDrop traffic
# is sent from or to, in either direction. Without it there is nothing to send
# over and nothing to bind, whatever else is configured.
awdl_link_local() {
  ip -6 addr show dev awdl0 scope link 2>/dev/null | grep -q inet6
}


# The shape of the window lives in the watcher's arguments, nowhere else:
# `cmd_on` starts it with --once or --window <span> before the radio, so
# `status` can name the window while the radio is still coming up, and before
# the deadline exists. Reading it back off the unit keeps `status` honest
# without a second piece of state to drift.
watch_mode() {
  local exec
  exec=$(systemctl --user show "$WATCH.service" -p ExecStart --value 2>/dev/null) || return 1
  case "$exec" in
    *"watch --once"*)   printf 'once\n' ;;
    *"watch --window"*) printf 'timed\n' ;;
    *watch*)            printf 'forever\n' ;;
    *) return 1 ;;
  esac
}

# Seconds until the pending window closes, or nothing at all when no window is
# armed.
#
# An --on-active timer is monotonic, so systemd leaves NextElapseUSecRealtime
# empty and answers on NextElapseUSecMonotonic -- and it answers with a
# formatted span ("10min 4.99s"), not the microseconds the property name
# promises. systemd-analyze turns that back into a number.
#
# The clock to compare it against is CLOCK_MONOTONIC, which is NOT what
# /proc/uptime reports: uptime counts suspended time and CLOCK_MONOTONIC does
# not. A laptop that has slept for fifteen minutes reads fifteen minutes ahead
# of the deadline, the subtraction goes negative, and the panel loses its
# countdown on exactly the machines this ships to (observed with 9 minutes
# left on the timer: uptime 54506, deadline 54142).
#
# If any step comes up empty we report no window rather than guess, and the
# caller says "until you turn it off" -- wrong in the harmless direction.
window_remaining() {
  local span us now secs
  span=$(systemctl --user show "$WINDOW.timer" \
           -p NextElapseUSecMonotonic --value 2>/dev/null) || return 1
  [[ -n "$span" && "$span" != 0 && "$span" != "n/a" && "$span" != infinity ]] || return 1
  us=$(systemd-analyze timespan "$span" 2>/dev/null \
         | awk -F': *' '$2 ~ /^[0-9]+$/ { print $2; exit }')
  [[ -n "$us" ]] || return 1
  now=$(python3 -c 'import time; print(time.clock_gettime(time.CLOCK_MONOTONIC))') || return 1
  secs=$(awk -v u="$us" -v n="$now" 'BEGIN { printf "%d", u / 1000000 - n }')
  (( secs > 0 )) || return 1
  printf '%s\n' "$secs"
}

cancel_window() {
  systemctl --user stop "$WINDOW.timer" >/dev/null 2>&1 || true
  systemctl --user stop "$WATCH.service" >/dev/null 2>&1 || true
  systemctl --user stop "$ID_EXPIRY.timer" >/dev/null 2>&1 || true
}

# systemd time span -> whole seconds, for the radio primitive's argument.
#
# Read the MICROSECONDS line, not merely the first line whose value is all
# digits. `systemd-analyze timespan` echoes the input back first:
#
#     Original: 5          <- all digits for a bare number
#           µs: 5000000
#        Human: 5s
#
# so a bare integer matched `Original:`, and 5/1000000 truncated to 0 -- which
# cmd_on reads as the slider's floor and turns into a one-shot window. `omdrop
# on 5` therefore answered "until one file arrives" (reported 2026-09-19).
# Units hid it: `10m` echoes as `10m`, which is not all digits, so it fell
# through to the right line by luck.
#
# Skipping the first line is what makes this correct for every input rather
# than for the inputs we happened to try. The label is matched loosely because
# it is a non-ASCII µ; the line number is the reliable part.
span_seconds() {
  systemd-analyze timespan "$1" 2>/dev/null \
    | awk -F': *' 'NR > 1 && $2 ~ /^[0-9]+$/ { printf "%d", $2 / 1000000; exit }'
}


setting_get() {
  [[ -r "$SETTINGS" ]] || return 0
  sed -n "s/^$1=//p" "$SETTINGS" | tail -1
}

setting_set() {
  mkdir -p "$(dirname "$SETTINGS")"
  local tmp; tmp=$(mktemp "$SETTINGS.XXXXXX")
  { [[ -r "$SETTINGS" ]] && grep -v "^$1=" "$SETTINGS"; echo "$1=$2"; } > "$tmp"
  mv -f "$tmp" "$SETTINGS"
}


# ~/Downloads reads better than /home/someone/Downloads everywhere a person
# sees it.
tildify() { local p=$1; printf '%s\n' "${p/#$HOME/\~}"; }

default_name() { hostname -s 2>/dev/null || echo omdrop; }
effective_name() { local n; n=$(cfg_get name); [[ -n "$n" ]] && printf '%s\n' "$n" || default_name; }
effective_dir() { local d; d=$(cfg_get download_dir); [[ -n "$d" ]] && printf '%s\n' "$d" || printf '%s\n' "$HOME/Downloads"; }
effective_limit() { local n; n=$(cfg_get max_receive_percent); printf '%s\n' "${n:-30}"; }

cfg_get() {
  CONFIG="$CONFIG" python3 - "$1" <<'PY'
import os, sys
try:
    import tomllib
except ModuleNotFoundError:  # Python < 3.11: same API from the tomli package
    import tomli as tomllib
try:
    with open(os.environ['CONFIG'], 'rb') as f:
        print(tomllib.load(f).get(sys.argv[1], ''))
except FileNotFoundError:
    print('')
except tomllib.TOMLDecodeError as e:
    sys.exit(f'{os.environ["CONFIG"]}: {e}')
PY
}

# Rewrite one key, keeping every other key the file already carries. Atomic, so
# a receiver starting mid-write never reads half a file.
cfg_set() {
  CONFIG="$CONFIG" python3 - "$1" "$2" <<'PY'
import os, sys, tempfile
try:
    import tomllib
except ModuleNotFoundError:  # Python < 3.11: same API from the tomli package
    import tomli as tomllib
path, key, val = os.environ['CONFIG'], sys.argv[1], sys.argv[2]
os.makedirs(os.path.dirname(path), exist_ok=True)
try:
    with open(path, 'rb') as f:
        cfg = tomllib.load(f)
except FileNotFoundError:
    cfg = {}
except tomllib.TOMLDecodeError as e:
    sys.exit(f'{path}: {e}')
cfg[key] = int(val) if key == 'max_receive_percent' else val
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix='.config.toml.')
with os.fdopen(fd, 'w') as f:
    for k, v in cfg.items():
        if isinstance(v, bool):
            rendered = 'true' if v else 'false'
        elif isinstance(v, int):
            rendered = str(v)
        elif isinstance(v, str):
            esc = v.replace('\\', '\\\\').replace('"', '\\"')
            rendered = f'\"{esc}\"'
        else:
            sys.exit(f'{path}: cannot preserve unsupported value for {k}')
        f.write(f'{k} = {rendered}\n')
os.chmod(tmp, 0o644)
os.replace(tmp, path)
PY
}

# ------------------------------------------------------------------ first run
#
# Nothing runs when a plugin is installed: `omarchy plugin add` clones a
# repository and enables it, and that is the whole mechanism. So the systemd
# user unit that runs the receiver, the config file it reads and the TLS
# material it serves with have to be created by a command somebody runs once.
# That command is this one, and the panel may call it too, so every step is
# idempotent: it compares before it writes and says only what it changed.
#
# What it cannot do is install the driver package. That needs root and pacman,
# and pretending otherwise would turn "set up" into a promise we break at the
# first transfer. Missing pieces get named, never guessed at and never faked.

# The plugin we were run from -- it carries the unit template and the receiver.
# Follow $0 one symlink at a time and stop at the first directory whose parent
# holds manifest.json. Not straight to readlink -f: during development the
# plugin's bin/omdrop can itself be a symlink into a source checkout, and
# resolving all the way lands beside the script instead of beside the files
# that shipped with it. Not $0 alone either: through the ~/.local/bin/omdrop
# symlink that setup creates, that lands in ~/.local (issue 12).
plugin_dir() {
  local path="$0" dir hops=0 next
  while (( hops++ < 16 )); do
    dir=$(cd "$(dirname "$path")/.." 2>/dev/null && pwd) || return 1
    [[ -r "$dir/manifest.json" ]] && { printf '%s\n' "$dir"; return 0; }
    [[ -L "$path" ]] || return 1
    next=$(readlink "$path") || return 1
    [[ "$next" == /* ]] || next="$(dirname "$path")/$next"
    path=$next
  done
  return 1
}

# The receiver's one import from outside the standard library, and the
# official-repository package that provides it. The probe names the API the
# receiver calls, because an unrelated `libarchive` module would satisfy a bare
# import and still fail on the first upload.
#
# keyutils is the kernel keyring's library: the 1Password identity cache lives
# in the keyring, and the receiver reads it through libkeyutils.
RECEIVER_PKGS="python-libarchive-c keyutils"
receiver_libs_installed() {
  # The interpreter share/airdrop-receiver.service runs, not whichever python3
  # PATH finds first (mise, pyenv, a venv), which may lack these packages.
  "${OMDROP_RECEIVER_PYTHON:-/usr/bin/python3}" -c 'from libarchive import stream_reader; import ctypes; ctypes.CDLL("libkeyutils.so.1")' >/dev/null 2>&1
}

# The identity this computer presents to Apple devices: its certificate and
# key, and the Apple ID validation record when there is one. It lived in
# ~/.opendrop while the receiver ran on opendrop, and moves to ~/.omdrop now
# that opendrop is gone.
IDENTITY_DIR="$HOME/.omdrop"
LEGACY_IDENTITY_DIR="$HOME/.opendrop"

# Copy an existing ~/.opendrop/keys into ~/.omdrop/keys, once. Only when
# ~/.omdrop does not exist at all, so an identity already there is never
# replaced, and never touching the original: opendrop itself may still be in
# use elsewhere on this machine. The copy is assembled beside its destination
# and renamed into place, so an interrupted copy leaves nothing that looks like
# an identity. Returns 0 when it copied, 1 when there was nothing to do, 2 on
# failure.
migrate_identity() {
  [[ -e "$IDENTITY_DIR" || -L "$IDENTITY_DIR" ]] && return 1
  [[ -d "$LEGACY_IDENTITY_DIR/keys" ]] || return 1
  local tmp
  tmp=$(umask 077 && mktemp -d "$IDENTITY_DIR.XXXXXX") || return 2
  # -p keeps each file's 0600 mode; the directories are made 0700 here.
  if (umask 077 && mkdir -- "$tmp/keys") \
     && cp -pR -- "$LEGACY_IDENTITY_DIR/keys/." "$tmp/keys/" \
     && chmod 700 -- "$tmp" "$tmp/keys" \
     && mv -T -- "$tmp" "$IDENTITY_DIR"; then
    return 0
  fi
  rm -rf -- "$tmp"
  return 2
}

# Run before anything reads the identity. Says what it did, because a copied
# identity is something the person may want to know about.
prepare_identity() {
  migrate_identity
  case $? in
    0) echo "Copied this computer's AirDrop identity from $LEGACY_IDENTITY_DIR/keys to $IDENTITY_DIR/keys. The original is left in place." ;;
    2) echo "omdrop could not copy the AirDrop identity from $LEGACY_IDENTITY_DIR/keys to $IDENTITY_DIR/keys." >&2; return 1 ;;
  esac
  return 0
}

# The self-signed identity every mode falls back to, made here rather than in
# the middle of somebody's first transfer: openssl takes a moment, and the
# unit's start would be waiting on it while a sender is already knocking. It
# is only ever created under the .self-signed.pem names, and never replaces a
# file; an older install's self-signed pair under the Apple names is renamed
# only when it is provably self-signed. See docs/identity-contract.md.
# Returns 0 when it created the pair, 1 when there was nothing to do, 2 on
# failure.
ensure_tls() {
  "$ID_PY" ensure-self-signed --name "$(effective_name)" >/dev/null
}

# The identity lock, shared with bin/identity.py. `on` holds it from the check
# that no `off` ran during a 1Password fetch until the receiver and radio are
# up, and `off` holds it throughout, so the two can never interleave. Fixed
# descriptor 8: anything long-lived started under it gets `8>&-`, so a radio
# supervisor cannot inherit the lock and hold it for the life of the window.
identity_lock() {
  local dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omdrop"
  (umask 077 && mkdir -p -- "$dir") || die "omdrop could not create $dir"
  exec 8>"$dir/identity.lock" || die "omdrop could not open its identity lock"
  flock 8
}
identity_unlock() { exec 8>&-; }

# A notice from the identity step, on stderr and as a toast: falling back to
# the self-signed identity changes who can see this computer.
identity_notice() {
  local msg=$1
  printf '%s\n' "$msg" >&2
  command -v omarchy-notification-send >/dev/null 2>&1 \
    && omarchy-notification-send -t 8000 "Omdrop" "$msg" >/dev/null 2>&1
  return 0
}

# `omdrop identity`: which identity this computer presents, and 1Password.
cmd_identity() {
  local sub=${1:-status}
  case "$sub" in
    status) shift || true; "$ID_PY" status "$@" ;;
    unlock) "$ID_PY" unlock ;;
    lock)
      # Turn off first: a running receiver holds the key in its memory, and
      # revoking the cache cannot reach that copy.
      if receiving || [[ -e "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omdrop/window" ]]; then
        cmd_off --force >/dev/null
      fi
      "$ID_PY" lock ;;
    1password)
      shift
      case "${1:-}" in
        import) shift; driver_identity_ready; "$ID_PY" import "$@" ;;
        use)    shift; driver_identity_ready; "$ID_PY" use "$@" ;;
        off)    "$ID_PY" 1password-off ;;
        *) die "usage: omdrop identity 1password import [--vault V] [--title T] | use ITEM [--vault V] | off" ;;
      esac ;;
    *) die "usage: omdrop identity [status [--json] | unlock | lock | 1password ...]" ;;
  esac
}

# Moving the Apple identity off disk needs a driver whose sender follows the
# identity contract. An older sender finds certificate.pem missing and makes
# a self-signed pair under the Apple identity's names.
driver_identity_ready() {
  local installed
  if radio_probe; then
    radio_probe_hung && die "$(radio_probe_hung_say)"
    # A backend states which omdrop-awdl helper contract it follows.
    installed=$(probe_field contract)
    if [[ -z "$installed" ]] || ! version_ge "$installed" "$DRIVER_IDENTITY_VERSION"; then
      die "Keeping the identity in 1Password needs a radio backend that follows contract $DRIVER_IDENTITY_VERSION or newer ($(probe_field backend) follows ${installed:-none})."
    fi
    return 0
  fi
  installed=$(pacman -Q "$DRIVER_PKG" 2>/dev/null) || installed=
  installed=${installed##* }
  if [[ -z "$installed" ]] || ! version_ge "$installed" "$DRIVER_IDENTITY_VERSION"; then
    die "Keeping the identity in 1Password needs driver $DRIVER_IDENTITY_VERSION or newer (installed: ${installed:-none}). Update it with: omdrop install-driver"
  fi
}

# Write the receiving service from this plugin's template when the installed
# copy differs from it. Returns 0 when it wrote something, 1 when it was
# already current. Run by setup and before every start, so an updated plugin
# never runs its receiver under the previous version's unit: 0.9.1 moved the
# identity to ~/.omdrop, and a unit that still only allowed writes to
# ~/.opendrop failed every Discover.
unit_install() {
  local plugin=$1 template rendered unit_target installed dropin changed=1
  template="$plugin/share/$UNIT"
  [[ -r "$template" ]] \
    || die "This copy of omdrop is missing the file that describes the receiving service, so there is nothing to set up. Install the plugin again."
  [[ -r "$plugin/bin/airdrop-serve.py" ]] \
    || die "This copy of omdrop is missing the program that receives files. Install the plugin again."

  # Bash substitution rather than sed: an installation path may hold any
  # character a filename may hold, and sed would need it escaped for whichever
  # delimiter we picked.
  rendered=$(cat "$template") || die "omdrop could not read its own files."
  rendered=${rendered//@PLUGIN_DIR@/$plugin}
  # A unit with the placeholder still in it is a unit that starts nothing, and
  # it would fail at the worst moment -- when someone is standing there trying
  # to send a file. Refuse to write one.
  [[ "$rendered" != *@PLUGIN_DIR@* ]] \
    || die "omdrop could not work out where it is installed, so the receiving service was left alone."

  unit_target="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$UNIT"
  mkdir -p "$(dirname "$unit_target")" \
    || die "omdrop could not create the folder systemd keeps your own services in."
  installed=
  [[ -r "$unit_target" ]] && installed=$(cat "$unit_target")
  if [[ "$rendered" != "$installed" ]]; then
    printf '%s\n' "$rendered" > "$unit_target" \
      || die "omdrop could not write the receiving service."
    changed=0
  fi
  # `omdrop dir` drop-ins written before 0.9.1 name the old identity folder.
  dropin="$unit_target.d/10-download-dir.conf"
  if [[ -f "$dropin" ]] && grep -qx 'ReadWritePaths=%h/.opendrop' "$dropin"; then
    sed -i 's|^ReadWritePaths=%h/\.opendrop$|ReadWritePaths=%h/.omdrop|' "$dropin" \
      || die "omdrop could not update $dropin."
    changed=0
  fi
  if (( changed == 0 )); then
    systemctl --user daemon-reload \
      || die "The receiving service was written, but systemd would not reload it. Log out and back in, then try again."
  fi
  return "$changed"
}

# Put `omdrop` on the user's PATH, as a link to PLUGIN's bin/omdrop. The
# plugin manifest has no way to declare a command -- schema 1 knows bar
# widgets, services and overlays, not binaries -- so nothing else does this,
# and every command in the README is unusable until something does.
# ~/.local/bin is on PATH by default on Omarchy. Shared by setup and
# install-core: core's package puts nothing on PATH, so replacing an older
# core that sat at /usr/bin/omdrop must not leave the user without a command.
#
# A symlink rather than a copy, so an update to the plugin updates the
# command too. Only ever replaced when it points into a plugin directory or
# is dangling: a user who put their own omdrop there outranks us. Returns 0
# when it created or changed the link.
link_command() {
  local plugin=$1 bindir="${XDG_BIN_HOME:-$HOME/.local/bin}" link current=''
  link="$bindir/omdrop"
  [[ -e "$link" || -L "$link" ]] && current=$(readlink -f "$link" 2>/dev/null)
  if [[ -z "$current" || "$current" == */plugins/*/bin/omdrop ]]; then
    if mkdir -p "$bindir" && ln -sfn "$plugin/bin/omdrop" "$link"; then
      [[ "$current" == "$plugin/bin/omdrop" ]] && return 1
      echo "Put the omdrop command on your PATH at $link."
      return 0
    fi
    echo "omdrop could not create $link, so the omdrop command is not on your PATH. Create it by hand: ln -s $plugin/bin/omdrop $link" >&2
  elif [[ "$current" != "$plugin/bin/omdrop" ]]; then
    echo "Left $link alone: it is not ours and points at $current." >&2
  fi
  return 1
}

# The version a plugin directory's manifest.json declares, or nothing.
manifest_version() {
  sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$1/manifest.json" 2>/dev/null | head -n 1
}

# The omdrop package installs this plugin under /usr/share/omdrop. The shell
# loads third-party plugins only from ~/.config/omarchy/plugins, which a
# package cannot write to, so setup links the packaged copy in there for each
# user, as omarchy-meeting-recorder and flea do theirs. Only a packaged copy
# (one under /usr) does this: setup run from a development checkout never
# touches the user's installed plugin.
#
# A previous installation -- a git or marketplace clone, or a link to another
# copy -- is replaced only after the user says so, which needs a terminal. The
# panel's first `omdrop on` runs setup without one; then it is left in place
# with a warning, and the next `omdrop setup` asks. A replaced clone is moved
# aside to a hidden directory, which the shell ignores, not deleted. Returns 0
# when it linked the plugin. OMDROP_PACKAGE_ROOT moves /usr for tests; it only
# decides whether setup links the plugin into the user's own home.
PLUGIN_ID=netmojo.omdrop
plugin_packaged() {
  [[ "$(readlink -f "$1")" == "$(readlink -f "${OMDROP_PACKAGE_ROOT:-/usr}")"/* ]]
}
link_plugin() {
  local plugin dir="$HOME/.config/omarchy/plugins" target old answer aside
  plugin=$(readlink -f "$1") || return 1
  plugin_packaged "$plugin" || return 1
  target="$dir/$PLUGIN_ID"
  [[ -L "$target" && "$(readlink -f "$target")" == "$plugin" ]] && return 1
  if [[ -L "$target" && ! -e "$target" ]]; then
    rm -f "$target"
  elif [[ -e "$target" ]]; then
    old=$(readlink -f "$target")
    if [[ ! -t 0 || ! -t 1 ]]; then
      echo "A previous Omdrop plugin installation is at $old, so the shell still runs it rather than the omdrop package. Run omdrop setup in a terminal to replace it." >&2
      return 1
    fi
    local have want with
    have=$(manifest_version "$target")
    want=$(manifest_version "$plugin")
    if [[ -n "$have" && -n "$want" ]] && ! version_ge "$have" "$want"; then
      with="with a newer version ($have → $want)"
    else
      with="with version ${want:-unknown} (installed: ${have:-unknown})"
    fi
    printf 'Previous Omdrop plugin installation detected at %s. This package will replace it %s. Continue? (Y/n) ' "$old" "$with"
    read -r answer || answer=n
    case "${answer,,}" in
      ''|y|yes) ;;
      *) echo "Left $old in place: the shell keeps running it, not the omdrop package."; return 1 ;;
    esac
    if [[ -L "$target" ]]; then
      rm -f "$target" || { echo "omdrop could not remove the link $target." >&2; return 1; }
    else
      aside="$dir/.$PLUGIN_ID.replaced-$(date +%Y%m%d-%H%M%S)"
      mv "$target" "$aside" || { echo "omdrop could not move $target aside, so it left it in place." >&2; return 1; }
      echo "Moved the previous installation to $aside. Delete it once Omdrop works from the package."
    fi
  fi
  if ! { mkdir -p "$dir" && ln -s "$plugin" "$target"; }; then
    echo "omdrop could not link $target to $plugin, so the bar has no Omdrop widget. Create the link by hand: ln -s $plugin $target" >&2
    return 1
  fi
  echo "Added Omdrop to the shell's plugins: $target links to $plugin."
  command -v omarchy-shell >/dev/null 2>&1 && omarchy-shell shell rescanPlugins >/dev/null 2>&1
  return 0
}

# Add the packaged plugin's widget to the bar, once. Kept apart from the link,
# so a failed `omarchy plugin enable` is retried by the next setup, and
# remembered once it worked, so a user who later removes the widget keeps it
# removed.
add_widget() {
  local plugin target="$HOME/.config/omarchy/plugins/$PLUGIN_ID"
  plugin=$(readlink -f "$1") || return 1
  [[ -L "$target" && "$(readlink -f "$target")" == "$plugin" ]] || return 1
  [[ "$(setting_get widget_added)" == 1 ]] && return 1
  if command -v omarchy-plugin-enable >/dev/null 2>&1 && omarchy-plugin-enable "$PLUGIN_ID" >/dev/null 2>&1; then
    setting_set widget_added 1
    echo "Added its widget to the bar."
    return 0
  fi
  echo "omdrop could not add its widget to the bar. The next omdrop setup tries again, or run: omarchy plugin enable $PLUGIN_ID" >&2
  return 1
}

# Everything `setup` installs, each step idempotent. Returns 0 when it changed
# something, 1 when everything was already in place. Shared with require_unit,
# so the first `omdrop on` sets up a fresh install without being asked.
setup_install() {
  local plugin did=0

  plugin=$(plugin_dir) \
    || die "omdrop cannot tell where it is installed, so it did not change anything."
  if unit_install "$plugin"; then
    did=1
    echo "Set up the service that receives files."
  fi

  # A packaged copy has /usr/bin/omdrop. An existing ~/.local/bin/omdrop names
  # the plugin's path under ~/.config, so it follows the copy link_plugin
  # puts there, and keeps following the old one if the user declines.
  plugin_packaged "$plugin" || { link_command "$plugin" && did=1; }
  link_plugin "$plugin" && did=1
  add_widget "$plugin" && did=1

  # Received links are stored as .url files, and a Mac may send a .webloc.
  # Without this, double-clicking one opens it in a text editor.
  links_install "$plugin" && did=1

  if [[ -z "$(cfg_get name)" ]]; then
    cfg_set name "$(default_name)" \
      || die "omdrop could not save the name Apple devices will see."
    did=1
    printf 'Apple devices will see this computer as "%s". Change it with: omdrop name\n' "$(effective_name)"
  fi

  # A failed copy must not be followed by a fresh certificate: that would
  # create ~/.omdrop, the copy would never be tried again, and an Apple ID
  # identity in ~/.opendrop would be silently replaced by a self-signed one.
  local migrated
  migrate_identity; migrated=$?
  case $migrated in
    0) did=1; echo "Copied this computer's AirDrop identity from $LEGACY_IDENTITY_DIR/keys to $IDENTITY_DIR/keys. The original is left in place." ;;
    2) echo "omdrop could not copy the AirDrop identity from $LEGACY_IDENTITY_DIR/keys to $IDENTITY_DIR/keys." >&2 ;;
  esac
  if (( migrated != 2 )); then
    ensure_tls
    case $? in
      0) did=1; echo "Created the certificate this computer identifies itself with." ;;
      2) echo "The certificate this computer identifies itself with could not be created in $IDENTITY_DIR/keys; the reason is above." >&2 ;;
    esac
  fi

  (( did ))
}

cmd_setup() {
  setup_install || echo "Everything omdrop sets up for you was already in place."

  local missing=() offers=()
  readarray -t missing < <(prereqs_missing)
  readarray -t offers < <(core_offers)

  if (( ${#missing[@]} )); then
    printf '\nNot ready to receive yet:\n'
    printf -- '  - %s\n' "${missing[@]}"
  else
    printf '\nReady. Turn receiving on from the bar, or run: omdrop on\n'
  fi
  if (( ${#offers[@]} )); then
    printf '\nTo do:\n'
    printf -- '  - %s\n' "${offers[@]#*$'\t'}"
  fi
  skills_offer
}

# What is missing, in the order it has to be fixed: no receiver library means
# nothing can serve, no driver means no radio, and awdl0 only appears once the
# driver is loaded. One sentence each, for someone holding a laptop.
#
# Shared with `doctor` rather than living inside `setup`, because the panel
# needs it too: a first run that cannot work showed "Not available" and a
# pointer to the README, which is the whole first-run experience for anyone who
# installed the plugin before the driver.
# Each line is "id<TAB>sentence": the id is for the panel, which offers to fix
# the one thing it can, and the sentence is for the person reading it.
# Broadcom (vendor 0x14e4) network hardware on PCI, which is where Apple's
# Wi-Fi sits on Apple Silicon. Without it the driver cannot help: a VM such as
# Try Omarchy, or another laptop, has no AWDL-capable radio to configure, and
# building a kernel module there only fails.
apple_broadcom_wifi() {
  local d
  # OMDROP_SYSFS lets the tests describe the hardware instead of depending on
  # the machine they run on.
  for d in "${OMDROP_SYSFS:-/sys}"/bus/pci/devices/*; do
    [[ "$(cat "$d/vendor" 2>/dev/null)" == 0x14e4 && "$(cat "$d/class" 2>/dev/null)" == 0x0280* ]] && return 0
  done
  return 1
}

# The radio half is a separate package: omdrop-awdl for Apple's Broadcom Wi-Fi,
# or another radio backend. A backend may describe itself through
# `omdrop-discoverable probe --json`, run unprivileged (docs/radio-backend.md).
# One that does owns the hardware and installation checks for its own radio;
# one that does not is taken to be omdrop-awdl on Apple's Broadcom Wi-Fi and
# gets the checks below, unchanged. omdrop-awdl answers a subcommand it does
# not know with its usage and exit 2, which is how it reads as "no probe".

# The probe reads a few files and answers. One that hangs would hang doctor
# with it, and the panel waiting on doctor, so it gets this long. timeout puts
# the helper in a process group of its own and signals all of it, so a child
# still holding stdout open cannot keep the command substitution waiting.
# OMDROP_PROBE_TIMEOUT lets the tests wait less.
PROBE_TIMEOUT=${OMDROP_PROBE_TIMEOUT:-5}
# The oldest omdrop-awdl helper contract this plugin works with, for every
# backend that probes. 0.7.0 is the first whose sender, send-to-peer and
# advertiser follow docs/identity-contract.md. Features newer than this are
# found by asking the sender (`--help`), not by version.
BACKEND_CONTRACT_MIN=0.7.0
# The first omdrop-awdl whose sender cleans peer names itself (clean_name in
# airdrop-send.py: no controls, line or paragraph separators, bidi or
# zero-width characters, at most 255 bytes). Its names cannot hold a line
# break, so each line it prints is one peer, and `peers --stream` can pass a
# row on as it arrives. Any other sender's rows wait for the whole lookup.
NAMES_CLEAN_VERSION=0.10.1
# Item IDs the plugin reports itself, and the panel acts on. A backend's own
# item under one of these names is passed on as backend-<id>, so its sentence
# still shows but no button offers a fix that cannot fix it.
PLUGIN_ITEM_IDS="driver library service"

# RADIO_PROBE: empty until asked, then `none` (omdrop-awdl), `hung` (a helper
# that did not answer in time) or the probe's JSON. A hung helper still counts
# as a backend that probes: omdrop-awdl answers an unknown command at once, so
# falling back to its Broadcom checks would only tell a non-Mac it is not one.
RADIO_PROBE=
radio_probe() {
  if [[ -z "$RADIO_PROBE" ]]; then
    RADIO_PROBE=none
    local out rc=0
    if [[ -x "$DISCOVERABLE" ]]; then
      out=$(timeout -k 1 "$PROBE_TIMEOUT" "$DISCOVERABLE" probe --json 2>/dev/null) || rc=$?
      if (( rc == 124 || rc == 137 )); then
        RADIO_PROBE=hung
      elif (( rc == 0 )) && printf '%s' "$out" | python3 -c '
import json, sys
p = json.load(sys.stdin)
assert isinstance(p, dict) and isinstance(p.get("backend"), str) and p["backend"].strip()' 2>/dev/null; then
        RADIO_PROBE=$out
      fi
    fi
  fi
  [[ "$RADIO_PROBE" != none ]]
}

radio_probe_hung() {
  radio_probe && [[ "$RADIO_PROBE" == hung ]]
}

radio_probe_hung_say() {
  printf '%s' "The radio backend did not answer when asked what it needs ($DISCOVERABLE probe, $PROBE_TIMEOUT seconds). Reinstalling or updating its package may help."
}

# One field of the probe as text: strings as they are, booleans as true/false,
# anything absent as nothing.
probe_field() {
  [[ "$RADIO_PROBE" == "{"* ]] || return 0
  PROBE="$RADIO_PROBE" python3 -c '
import json, os, sys
v = json.loads(os.environ["PROBE"]).get(sys.argv[1])
print("" if v is None else str(v).lower() if isinstance(v, bool) else v)' "$1"
}

# The backend's blockers, in its order, as prereqs_missing lines.
probe_missing() {
  [[ "$RADIO_PROBE" == "{"* ]] || return 0
  PROBE="$RADIO_PROBE" RESERVED="$PLUGIN_ITEM_IDS" python3 -c '
import json, os
reserved = os.environ["RESERVED"].split()
for m in json.loads(os.environ["PROBE"]).get("missing") or []:
    if isinstance(m, dict) and m.get("id") and m.get("say"):
        i = str(m["id"])
        print("%s\t%s" % ("backend-" + i if i in reserved else i, " ".join(str(m["say"]).split())))'
}

# Whether the backend follows at least the plugin's minimum contract. One
# that names none is taken to follow none.
backend_contract_ok() {
  local contract
  contract=$(probe_field contract)
  [[ -n "$contract" ]] && version_ge "$contract" "$BACKEND_CONTRACT_MIN"
}

backend_contract_say() {
  local contract
  contract=$(probe_field contract)
  printf '%s' "The installed radio backend ($(probe_field backend)) follows helper contract ${contract:-none}, older than the $BACKEND_CONTRACT_MIN this version of Omdrop needs. Update its package."
}

# Whether the sender keeps every peer on one line of its own: omdrop-awdl at
# NAMES_CLEAN_VERSION or newer, by its probe. No probe, a hung one, another
# backend, or an older version all count as no.
sender_names_clean() {
  radio_probe || return 1
  [[ "$(probe_field backend)" == awdl ]] || return 1
  local version
  version=$(probe_field version)
  [[ -n "$version" ]] && version_ge "$version" "$NAMES_CLEAN_VERSION"
}

# For messages that ask for a newer or missing radio helper: what provides
# it, and how to update it. `omdrop install-driver` builds omdrop-awdl; a
# backend that probes is a package of its own, which that command leaves alone.
radio_pkg() {
  if radio_probe; then echo "radio backend"; else echo "Wi-Fi driver package"; fi
}
radio_update() {
  if radio_probe; then
    local backend
    backend=$(probe_field backend)
    echo "Update the package that provides it${backend:+ ($backend)}: omdrop install-driver leaves it alone."
  else
    echo "Update it with: omdrop install-driver"
  fi
}

prereqs_missing() {
  if radio_probe; then
    # A backend that does not answer is alone too: install-driver refuses to
    # run for it, so a library item would offer the panel's button for nothing.
    if radio_probe_hung; then
      printf 'backend\t%s\n' "$(radio_probe_hung_say)"
      return 0
    fi
    # Hardware the backend cannot drive is, again, first and alone.
    if [[ "$(probe_field hardware)" == false ]]; then
      probe_missing | grep $'^hardware\t' \
        || printf 'hardware\t%s\n' "This computer's Wi-Fi is not one the installed radio backend ($(probe_field backend)) can drive."
      return 0
    fi
    backend_contract_ok || printf 'backend\t%s\n' "$(backend_contract_say)"
    probe_missing
    receiver_libs_installed \
      || printf 'library\t%s\n' "Packages the receiver needs ($RECEIVER_PKGS) are not installed. The button below installs them."
    have_unit || printf 'service\t%s\n' "The service that receives files is not installed yet. Turning Omdrop on installs it."
    return 0
  fi
  # First, and alone: nothing else on this list can be fixed on this machine.
  if ! apple_broadcom_wifi; then
    printf 'hardware\t%s\n' "This computer has no Apple Broadcom Wi-Fi, which Omdrop's own driver needs: it runs only on Apple Silicon Macs, not in a virtual machine. Other Wi-Fi cards need a different radio backend (docs/radio-backend.md)."
    return 0
  fi
  receiver_libs_installed \
    || printf 'library\t%s\n' "Packages the receiver needs ($RECEIVER_PKGS) are not installed. The button below installs them along with the driver."
  if [[ ! -x "$DISCOVERABLE" ]]; then
    printf 'driver\t%s\n' "The Wi-Fi driver that makes this computer visible to Apple devices is not installed. It has to be installed as an administrator."
  elif [[ ! -e /sys/class/net/awdl0 ]]; then
    printf 'radio\t%s\n' "The driver is installed but its Apple-compatible radio is not running yet, so nobody can see this computer. Restarting usually brings it up."
  fi
  have_unit || printf 'service\t%s\n' "The service that receives files is not installed yet. Turning Omdrop on installs it."
}

# `doctor` is the panel's version of the same answer. --json so the widget can
# render the first blocking sentence instead of a generic refusal, and know
# whether the thing in the way is one it can offer to install. `offers` are
# optional and never make it unready.
cmd_doctor() {
  local missing=() offers=()
  readarray -t missing < <(prereqs_missing)
  readarray -t offers < <(core_offers)
  if [[ "${1:-}" == --json ]]; then
    MISSING=$(printf '%s\n' "${missing[@]}") OFFERS=$(printf '%s\n' "${offers[@]}") python3 -c '
import json, os
def rows(name):
    return [l.split("\t", 1) for l in os.environ[name].split("\n") if l.strip()]
missing = rows("MISSING")
print(json.dumps({"ready": not missing,
                  "missing": [{"id": r[0], "say": r[1]} for r in missing],
                  "offers": [{"id": r[0], "say": r[1]} for r in rows("OFFERS")]}))'
    return 0
  fi
  if (( ${#missing[@]} )); then
    printf 'Not ready to receive yet:\n'
    printf -- '  - %s\n' "${missing[@]#*$'\t'}"
  else
    printf 'Ready to receive.\n'
  fi
  if (( ${#offers[@]} )); then
    printf '\nTo do:\n'
    printf -- '  - %s\n' "${offers[@]#*$'\t'}"
  fi
  # Which identity Apple devices will see, and anything left behind. Reported,
  # never repaired here: `omdrop off` is the one thing that clears a window.
  printf '\n'
  "$ID_PY" status 2>/dev/null || printf 'The identity could not be read.\n'
  if [[ -e "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omdrop/window" ]] && ! receiving; then
    printf 'A window'"'"'s identity file remains although nothing is receiving. Clear it with: omdrop off\n'
  fi
}

# AirDrop data reaches the ordinary user receiver through one kernel socket.
# UFW's default-drop policy sees that TCP traffic after the AWDL data path has
# done its job, so a healthy radio can advertise while every sender's SYN is
# discarded. This is the only firewall exception Omdrop needs: IPv6 link-local
# peers, to our IPv6 link-local address, on awdl0, TCP 8771.
#
# The DKMS package deliberately does not own this rule. It supplies a radio
# that other AWDL applications can use; opening an application port belongs to
# the application. `install-driver` calls this command in the same visible
# terminal after its package work, which normally reuses the same sudo
# authentication without putting Omdrop policy in the driver package.
UFW_RULE=(allow in on awdl0 from fe80::/10 to fe80::/10 port 8771 proto tcp
          comment "Omdrop AirDrop receiver")

ufw_active() {
  command -v ufw >/dev/null 2>&1 \
    && systemctl is-active --quiet ufw.service
}

cmd_firewall() {
  local action=${1:-}
  case "$action" in
    install)
      if ! command -v ufw >/dev/null 2>&1; then
        echo "UFW is not installed; no UFW rule is needed."
        return 0
      fi
      if ! systemctl is-active --quiet ufw.service; then
        echo "UFW is not active; Omdrop did not change its configuration."
        return 0
      fi
      echo "Allowing AirDrop receiver traffic only on awdl0, from IPv6 link-local peers, to TCP 8771."
      sudo ufw "${UFW_RULE[@]}"
      ;;
    remove)
      if ! command -v ufw >/dev/null 2>&1; then
        echo "UFW is not installed; there is no Omdrop UFW rule to remove."
        return 0
      fi
      sudo ufw --force delete "${UFW_RULE[@]}"
      ;;
    *)
      die "usage: omdrop firewall install|remove"
      ;;
  esac
}

# Installing a kernel module is not something a bar widget may do quietly. This
# follows Omarchy's own pattern for installing from a UI -- a floating terminal
# running the command, the user's own sudo prompt, all output visible -- rather
# than pkexec'ing a build script out of a plugin clone, which would be root
# running user-writable code. makepkg refuses to run as root anyway.
DRIVER_REPO=https://github.com/netmojo-systems/omdrop-awdl.git
# The package name a repository would carry it under, and the fallback source.
DRIVER_PKG=brcmfmac-awdl-dkms
# The exact driver commit this release of the plugin builds. A branch name
# would let the built source drift away from what anyone reviewed -- including
# the marketplace, whose baseline refuses an unpinned remote build -- so the
# checkout below is detached at this SHA and the build only runs if it
# succeeded. Bump it, in the same commit, whenever the plugin needs a newer
# driver: the full 40 characters, because a short SHA is not a pin.
DRIVER_COMMIT=58b3719655d29d3101cde7f5e857c4481ccc152a
# The package version that commit builds, with its pkgrel. install-driver
# rebuilds any older installed driver: a fix inside the helper, such as 0.5.1's,
# changes nothing a feature probe could see, and a packaging fix such as
# 0.6.3-2's (the kernel headers became a dependency) changes only the pkgrel.
DRIVER_VERSION=0.10.2
# The first driver whose sender, send-to-peer and advertiser follow
# docs/identity-contract.md. Moving the identity into 1Password needs it.
DRIVER_IDENTITY_VERSION=0.7.0

cmd_install_driver() {
  local self_q
  printf -v self_q '%q' "$0"
  if radio_probe; then
    install_for_backend
    return
  fi
  if [[ -x "$DISCOVERABLE" ]] && driver_current && receiver_libs_installed; then
    echo "The driver and the Python library the receiver needs are both installed and current. Nothing to do."
    return 0
  fi
  apple_broadcom_wifi \
    || die "This computer has no Apple Broadcom Wi-Fi, which Omdrop's own driver needs: it runs only on Apple Silicon Macs, not in a virtual machine. Other Wi-Fi cards need a different radio backend (docs/radio-backend.md)."
  # Into the cache directory, not a temp dir. Three reasons: someone who has
  # just installed a kernel module as root should still have the source they
  # built afterwards, /tmp is tmpfs on this hardware so the clone and the built
  # package would sit in RAM until reboot, and a later version is then a pull
  # rather than a fresh clone. Re-running this updates in place.
  #
  # Written as one script so the terminal shows exactly what it will run, and
  # so a user without the launcher can paste the same thing.
  local src="${XDG_CACHE_HOME:-$HOME/.cache}/omdrop/omdrop-awdl"
  local build="set -e"

  # The receiver's one outside import belongs to the receiver, not the kernel
  # module, so a user who installed the driver and nothing else would get a
  # working radio and a receiver that could not start. Install it here, from
  # the official repositories by exact package name: pacman verifies what it
  # installs, and nothing is built from a recipe fetched at install time.
  # --needed leaves an installed copy alone; --asdeps because it is there for
  # Omdrop, not something the user asked for by name.
  if ! receiver_libs_installed; then
    build="$build
sudo pacman -S --needed --asdeps $RECEIVER_PKGS"
  fi

  # A repository that already carries the driver makes building it pointless:
  # pacman installs a signed package in seconds, with no toolchain, no compile
  # output to read, and nothing fetched at install time that a reviewer has not
  # seen. Building stays for everyone whose repositories do not have it -- a
  # plain Asahi Arch install, or before the package reaches their architecture.
  #
  # `pacman -Si` reads the sync databases already on disk. It deliberately does
  # not refresh them: -Sy on its own is how partial upgrades happen, and a user
  # who asked to install AirDrop did not ask to move their system's package
  # state. A database that predates the package simply takes the build path.
  # So does one whose package is older than DRIVER_VERSION: a stale database
  # must not install a driver older than the pin, which may lack a fix the pin
  # carries, so only a version pacman reports as at least the pin is used.
  # An installed driver older than this plugin needs is rebuilt from the pin
  # too: that is the upgrade the "needs a newer driver" messages point at.
  if [[ ! -x "$DISCOVERABLE" ]] || ! driver_current; then
    local repo
    repo=$(LC_ALL=C pacman -Si "$DRIVER_PKG" 2>/dev/null | sed -n 's/^Version *: *//p' | head -n 1)
    if [[ -n "$repo" ]] && version_ge "$repo" "$DRIVER_VERSION"; then
      build="$build
sudo pacman -S --needed --noconfirm $DRIVER_PKG"
    else
      build="$build
mkdir -p \"\$(dirname '$src')\"
if [ -d '$src/.git' ]; then
  git -C '$src' fetch --quiet origin
else
  git clone --quiet $DRIVER_REPO '$src'
fi
echo 'Building driver commit $DRIVER_COMMIT'
git -C '$src' checkout --detach 58b3719655d29d3101cde7f5e857c4481ccc152a && makepkg --dir '$src' -si"
    fi
  fi

  # Keep the receiver's firewall policy in this plugin, not in the reusable
  # driver package. Running it in the same terminal means sudo normally reuses
  # the authentication from pacman/makepkg instead of asking a second time.
  if ufw_active; then
    build="$build
$self_q firewall install"
  fi
  if ! command -v omarchy-launch-floating-terminal-with-presentation >/dev/null 2>&1; then
    echo "Omdrop requires a patched wifi driver, which requires administrative privilege to install. You will be prompted for your password."
    echo
    echo "Install the driver with:"
    printf '\n%s\n\n' "$build"
    return 0
  fi
  echo "Opening a terminal to install the driver."
  # A subshell, so a failed step ends the script and not the terminal. With
  # `set -e` at the top level of the launcher's shell, the first failure exited
  # before the launcher's own "press any key" prompt, and the window closed
  # with the error in it before anyone could read it. Exit 130 skips the
  # launcher's "Done!", which a failure should not show.
  #
  # Tested on its own line, not with `||`: bash ignores `set -e` inside a
  # subshell whose status a `||` is testing, so every step would run on
  # regardless of the ones before it failing.
  launch_install "$build" "Omdrop requires a patched wifi driver, which requires administrative privilege to install. You will be prompted for your password."
}

# With a radio backend that probes, the radio is that package's business: it
# is installed (it answered), and it reports its own blockers through doctor.
# What remains is this plugin's own part, the receiver's packages and its
# firewall rule, run the same way as the driver install.
install_for_backend() {
  local build="set -e"
  # Without an answer there is no telling whether this backend is one the
  # plugin can work with, so nothing is installed for it.
  radio_probe_hung && die "$(radio_probe_hung_say)"
  # The plugin's part is still worth installing; the backend's update is not
  # something this command can do.
  backend_contract_ok || echo "$(backend_contract_say)" >&2
  receiver_libs_installed || build="$build
sudo pacman -S --needed --asdeps $RECEIVER_PKGS"
  ufw_active && build="$build
$self_q firewall install"
  if [[ "$build" == "set -e" ]]; then
    echo "The receiver's packages are installed and the radio comes from $(probe_field backend) $(probe_field version). Nothing to do."
    return 0
  fi
  if ! command -v omarchy-launch-floating-terminal-with-presentation >/dev/null 2>&1; then
    echo "Install what the receiver needs with:"
    printf '\n%s\n\n' "$build"
    return 0
  fi
  echo "Opening a terminal to install what the receiver needs."
  launch_install "$build" "Omdrop needs a few packages for its receiver, which requires administrative privilege to install. You will be prompted for your password."
}

# Run an install script in a floating terminal the user watches. A subshell,
# so a failed step ends the script and not the terminal: with `set -e` at the
# launcher's top level, the first failure closed the window before anyone
# could read it. Exit 130 skips the launcher's "Done!".
launch_install() {
  local build=$1 intro=$2
  local script="( $build
); rc=\$?; if [ \$rc -ne 0 ]; then echo; echo \"Installing failed (exit \$rc). The messages above say why.\"; read -rsn 1 -p 'Press any key to close...' </dev/tty; echo; exit 130; fi"
  omarchy-launch-floating-terminal-with-presentation "echo '$intro'; echo; $script"
}

# omdrop-core is built from this plugin's own core/, so the core a user runs
# is the one reviewed with the plugin. Its package version, from core/PKGBUILD,
# is how an installed core is judged current: core/ bumps pkgver or pkgrel
# whenever it changes in a release (CONTRIBUTING.md), as DRIVER_VERSION does.
CORE_PKG=omdrop-core
core_wanted() {
  local f="$PROJ/core/PKGBUILD" ver rel
  [[ -r "$f" ]] || return 1
  ver=$(sed -n 's/^pkgver=//p' "$f")
  rel=$(sed -n 's/^pkgrel=//p' "$f")
  [[ -n "$ver" && -n "$rel" ]] || return 1
  printf '%s-%s' "$ver" "$rel"
}

# Offered where it has been tested live: Apple's Broadcom Wi-Fi, with
# omdrop-awdl's helper or its hooks, on hardware that backend says it can
# drive. Other backends follow once core has run on them (issue #73).
core_supported() {
  if radio_probe; then
    [[ "$(probe_field backend)" == awdl && "$(probe_field hardware)" != false ]]
  else
    apple_broadcom_wifi
  fi
}

# Not a blocker, so receiving keeps working until it is installed, but not
# optional either: the Python version is going away. Not offered
# to someone who chose the Python version by name. This script runs only while
# no usable core is installed, or when OMDROP_IMPLEMENTATION=python; a usable
# core reports its own updates.
#
# A core older than CORE_MIN is installed but gets no commands, so say so,
# and name what updates it: install-core for the omdrop-core package where it
# offers one, otherwise the package OMDROP_CORE belongs to.
#
# An omdrop-core package with no OMDROP_CORE is one from before core moved off
# PATH (0.1.2 and older put it at /usr/bin/omdrop). It gets no commands either,
# and install-core replaces it, so offer that as an update.
core_offers() {
  [[ "${OMDROP_IMPLEMENTATION:-}" == python ]] && return 0
  if [[ -n "$CORE_NO_HOOKS" ]]; then
    # Core is installed but the backend gives it nothing to drive. On the
    # Broadcom backend that is an omdrop-awdl older than 0.10.0; elsewhere it
    # is a backend that has no hooks yet, which is not the user's to fix.
    core_supported || return 0
    printf 'core\t%s\n' "omdrop-core is installed, but the Wi-Fi driver is too old to run it, so Omdrop is running its Python version instead. Update it with: omdrop install-driver"
    return 0
  fi
  if [[ -n "$CORE_TOO_OLD" ]]; then
    local owner how
    owner=$(pacman -Qqo "$OMDROP_CORE" 2>/dev/null) \
      || owner=$(dpkg-query -S "$OMDROP_CORE" 2>/dev/null | sed -n '1s/:.*//p') \
      || owner=
    if [[ "$owner" == "$CORE_PKG" ]] && core_wanted >/dev/null && core_supported; then
      how="Update it with: omdrop install-core"
    elif [[ -n "$owner" ]]; then
      how="Update the $owner package, which provides it."
    else
      how="Update the package that provides it."
    fi
    printf 'core\t%s\n' "The installed omdrop-core ($CORE_TOO_OLD) is older than the $CORE_MIN this version of Omdrop needs, so Omdrop is running its Python version instead. $how"
    return 0
  fi
  local have want
  want=$(core_wanted) && core_supported || return 0
  if have=$(pacman -Q "$CORE_PKG" 2>/dev/null); then
    have=${have##* }
    version_ge "$have" "$want" && return 0
    printf 'core\t%s\n' "The installed omdrop-core ($have) is older than the $want this version of Omdrop needs, so Omdrop is running its Python version instead. Update it with: omdrop install-core"
    return 0
  fi
  printf 'core\t%s\n' "omdrop-core, the Rust version of Omdrop, is not installed. The Python version Omdrop is running instead is going away; install omdrop-core with: omdrop install-core"
}

# The omdrop package (omarchy-pkgs) installs this plugin under /usr/share/omdrop
# with core beside it. Core then belongs to that package, not to omdrop-core,
# which the package replaces.
OMDROP_PKG=omdrop
core_packaged() {
  [[ "$(pacman -Qqo "$OMDROP_CORE" 2>/dev/null)" == "$OMDROP_PKG" ]]
}

# Installed from a repository that carries this version or newer, and otherwise
# built from this plugin's core/ with makepkg, in the same visible terminal as
# install-driver. The build tree and package go to the cache, not the plugin's
# clone. Its tests ran in CI on the same tree, and need tools a user may not
# have, so the build skips them.
cmd_install_core() {
  local want have repo build cache core_q cache_q
  core_packaged \
    && die "omdrop-core comes with the $OMDROP_PKG package, which updates it with the rest of the system (omarchy update)."
  want=$(core_wanted) \
    || die "This copy of the plugin has no core/ to build omdrop-core from."
  if radio_probe; then
    radio_probe_hung && die "$(radio_probe_hung_say)"
    [[ "$(probe_field backend)" == awdl ]] \
      || die "omdrop-core has not been tested with the $(probe_field backend) radio backend yet. Until it has, it is installed only on Apple Broadcom Wi-Fi."
    [[ "$(probe_field hardware)" != false ]] \
      || die "This computer's Wi-Fi is not one the installed radio backend ($(probe_field backend)) can drive, so omdrop-core is not installed here."
  else
    apple_broadcom_wifi \
      || die "This computer has no Apple Broadcom Wi-Fi. omdrop-core has been tested only there so far, so it is not installed here."
  fi
  # Core's package puts nothing on PATH, and a core older than 0.1.3 was
  # /usr/bin/omdrop, which this install removes. Link the plugin's command
  # first, so the user keeps an omdrop whether or not the install succeeds.
  local plugin
  if plugin=$(plugin_dir); then
    link_command "$plugin"
  else
    echo "omdrop cannot tell where it is installed, so it did not put the omdrop command on your PATH. Run its bin/omdrop setup from the plugin directory." >&2
  fi
  if have=$(pacman -Q "$CORE_PKG" 2>/dev/null); then
    have=${have##* }
    if version_ge "$have" "$want"; then
      echo "omdrop-core $have is installed and current. Nothing to do."
      return 0
    fi
  fi
  # The programs change under a running window; the new ones start cleanly.
  receiving && die "Omdrop is receiving. Turn it off first (omdrop off), then run omdrop install-core again."

  repo=$(pacman -Si "$CORE_PKG" 2>/dev/null | sed -n 's/^Version *: *//p' | head -n 1)
  if [[ -n "$repo" ]] && version_ge "$repo" "$want"; then
    build="set -e
sudo pacman -S --needed $CORE_PKG"
  else
    cache="${XDG_CACHE_HOME:-$HOME/.cache}/omdrop/omdrop-core"
    printf -v core_q '%q' "$PROJ/core"
    printf -v cache_q '%q' "$cache"
    build="set -e
mkdir -p $cache_q
echo 'Building omdrop-core $want from this plugin.'
BUILDDIR=$cache_q/build PKGDEST=$cache_q makepkg --dir $core_q --syncdeps --install --needed --force --nocheck"
  fi
  build="$build
echo
echo 'omdrop-core is installed, and omdrop now runs it. OMDROP_IMPLEMENTATION=python runs the Python version instead.'"
  local intro="omdrop-core is installed as a system package, which requires administrative privilege. You will be prompted for your password."
  if ! command -v omarchy-launch-floating-terminal-with-presentation >/dev/null 2>&1; then
    echo "$intro"
    echo
    echo "Install omdrop-core with:"
    printf '\n%s\n\n' "$build"
    return 0
  fi
  echo "Opening a terminal to install omdrop-core."
  launch_install "$build" "$intro"
}

cmd_on() {
  require_unit

  # -c/--contacts and -e/--everyone pick who may send during this window.
  # They SET the saved visibility rather than applying for one window only: the
  # receiver reads that setting per request, and a mode that silently reverted
  # would be a privacy setting a user could not rely on. With no flag the saved
  # setting stands, which is "everyone" until someone changes it.
  local want_vis=
  while (( $# )); do
    case "$1" in
      -c|--contacts) want_vis=contacts; shift ;;
      -e|--everyone) want_vis=everyone; shift ;;
      --)            shift; break ;;
      -*)            die "omdrop on: unknown option $1. Use -c/--contacts or -e/--everyone." ;;
      *)             break ;;
    esac
  done
  (( $# <= 1 )) || die "omdrop on: one duration at a time, not \"$*\""

  # Before anything is armed, so a rejected duration cannot leave the mode
  # changed and the window closed.
  local dur=${1:-$DEFAULT_WINDOW} secs= mode=timed
  case "$dur" in
    forever) dur=; mode=forever ;;
    once)    dur=; mode=once ;;
    *)
      # Check the duration before touching anything: a typo must not leave us
      # visible with no window when a window is exactly what was asked for.
      [[ "$dur" =~ ^[0-9]+(s|sec|m|min|h|hour|d|day)?$ ]] \
        || die "duration $dur: a systemd time span such as 10m or 1h, or \"once\" or \"forever\""
      # A bare number means MINUTES. systemd reads it as seconds, so `omdrop on
      # 3` opened a three-second window that was over before the user read the
      # line saying it had opened. Minutes is what every example in the help
      # uses and what anyone typing a bare number means.
      [[ "$dur" =~ ^[0-9]+$ ]] && dur="${dur}m"
      secs=$(span_seconds "$dur")
      [[ -n "$secs" ]] || die "duration $dur: could not read that as a time span"
      # Zero means one-shot, which is how the panel's slider spells its floor.
      (( secs > 0 )) || { dur=; mode=once; }
      ;;
  esac

  # Only now that the duration is known good.
  if [[ -n "$want_vis" ]]; then
    cmd_visibility "$want_vis" >/dev/null \
      || die "omdrop on: could not switch to $want_vis, so nothing was turned on."
  fi

  # The identity is settled before anything starts, so a cancelled start has
  # nothing to undo. `begin` makes sure the self-signed pair exists and, when
  # the identity lives in 1Password and nothing usable is cached, fetches it:
  # the one step that runs without the identity lock, so `off` can interrupt
  # it. Then, under the lock, `window` refuses if an `off` ran meanwhile, and
  # otherwise fixes this window's identity; the lock is held until the
  # receiver and radio are up, so no `off` can slip in between.
  local id_out id_seq id_source= id_expiry= line
  id_out=$("$ID_PY" begin --name "$(effective_name)") \
    || die "The AirDrop receiver would not start: this computer's identity is unusable."
  while IFS= read -r line; do
    case "$line" in
      seq=*) id_seq=${line#seq=} ;;
      notice=*) identity_notice "${line#notice=}" ;;
    esac
  done <<<"$id_out"
  identity_lock
  local id_rc=0
  id_out=$("$ID_PY" window --seq "$id_seq") || id_rc=$?
  if (( id_rc == 3 )); then
    identity_unlock
    echo "Omdrop was turned off while it was starting." >&2
    return 0
  fi
  (( id_rc == 0 )) || die "The AirDrop receiver would not start: its identity could not be settled."
  while IFS= read -r line; do
    case "$line" in
      source=*) id_source=${line#source=} ;;
      expiry_in=*) id_expiry=${line#expiry_in=} ;;
      notice=*) identity_notice "${line#notice=}" ;;
    esac
  done <<<"$id_out"
  # Every way out of a failed start clears what `window` set up.
  identity_abort() { "$ID_PY" stop-begin >/dev/null 2>&1; "$ID_PY" stop-end >/dev/null 2>&1; }

  cancel_window

  # The 1Password cache's hard expiry is absolute: a window still open then is
  # turned off, because a kernel timeout cannot reach a key the receiver has
  # already loaded. Armed before anything starts, and a window that cannot arm
  # it does not start: a bound that is only advice is not a bound.
  if [[ "$id_source" == 1password && -n "$id_expiry" ]]; then
    if ! systemd-run --user --quiet --on-active="$(( id_expiry > 0 ? id_expiry : 1 ))s" \
         --unit="$ID_EXPIRY" "$SELF" off --force; then
      identity_abort
      die "The AirDrop receiver would not start: the identity cache's expiry could not be armed."
    fi
  fi

  # The watcher goes up BEFORE the radio and it carries the shape of the
  # window in its arguments, because `status` reads the mode off this unit: a
  # start whose units are not up yet would otherwise read as "forever", and the
  # panel's duration row followed that to its right-hand stop, "Until I turn it
  # off", for the whole length of the radio gate before snapping back (reported
  # 2026-09-18).
  #
  # The deadline itself is NOT armed here. A clock that starts before the radio
  # is up spends the gate -- up to 30 s -- counting down a window nobody can
  # send to: "1 minute" was down to 35 seconds by the time the tile appeared
  # (reported 2026-09-18). It is armed once receiving actually works, below.
  # Until then `remaining` is empty and the row shows the duration as a label,
  # which is exactly what it means.
  local watchArgs=()
  case "$mode" in
    once)  watchArgs=(--once) ;;
    timed) watchArgs=(--window "$dur") ;;
  esac
  systemd-run --user --quiet --unit="$WATCH" "$SELF" watch "${watchArgs[@]}" \
    || echo "receiving, but nothing is watching for arrivals" >&2


  # Receiver FIRST when it can start, radio second. Run 20260912T222217Z is the
  # argument for the order: the window advertised 16 s before the receiver was
  # listening, a sender found us in that gap, and 45 SYNs to 8771 were answered
  # by nothing -- 6 peers registered, zero HTTP requests, no file.
  #
  # But a cold awdl0 carries no link-local until AWDL is enabled and carrier
  # comes up, and the receiver refuses to start without one (03:57:16Z: it
  # failed outright and took the whole window with it). So when the address is
  # not there yet, the radio has to go first -- the exposure is then the second
  # between advertising and the receiver's bind, not sixteen.
  local RADIO_ERR=
  # What the radio side actually said, so the panel can show a reason instead
  # of a command to go and run. awdl-discoverable timestamps every line and
  # ends with the failure; keep that last line and drop the timestamp.
  radio_up() {
    [[ -x "$DISCOVERABLE" ]] || return 0
    local out rc
    # Bringing the radio up takes seven or eight seconds -- awdl0 has to come
    # up and prove it is receiving -- so it gets the same animation as naming.
    #
    # Only when the grant is passwordless, though: if pkexec has to ask for a
    # password it writes its prompt to the same terminal, and a spinner erasing
    # that line every 100 ms would stamp on the thing the person is trying to
    # type into. --disable-internal-agent makes the probe fail instead of
    # prompting, so asking is free and never surprises anyone.
    if pkexec --disable-internal-agent "$DISCOVERABLE" status >/dev/null 2>&1; then
      out=$(spinner_while "waking the radio" \
              pkexec "$DISCOVERABLE" start "${secs:-0}" 8>&- 2>&1 >/dev/null); rc=$?
    else
      out=$(pkexec "$DISCOVERABLE" start "${secs:-0}" 8>&- 2>&1 >/dev/null); rc=$?
    fi
    # 5 is "already starting or already visible": a race with a window that is
    # already coming up, not a refusal. Anything else is a real failure.
    (( rc == 0 || rc == 5 )) && return 0
    RADIO_ERR=$(printf '%s\n' "$out" | grep -v '^[[:space:]]*$' | tail -1 \
                | sed -E 's/^[0-9]{2}:[0-9]{2}:[0-9]{2}Z //')
    return 1
  }
  local receiver_first=0
  awdl_link_local && receiver_first=1

  # systemd latches a unit that failed too often: once the start limit is hit,
  # every later `start` is refused outright with no attempt made, and the panel
  # reports "The AirDrop receiver would not start" forever. That is what a user
  # meets the morning after a transfer -- the receiver could not rebind 8771,
  # restarted four times, and latched. Clearing the latch costs nothing when
  # there is none, and is the difference between a transient failure and a
  # feature that never works again.
  #
  # The unit and the identity are brought up to date first, so a plugin update
  # needs no separate `omdrop setup` before the receiver runs again.
  start_receiver() {
    local plugin
    plugin=$(plugin_dir) || { echo "omdrop cannot tell where it is installed." >&2; return 1; }
    unit_install "$plugin" || true
    prepare_identity >&2 || return 1
    ensure_tls; (( $? == 2 )) && return 1
    # The unit may write opt-in protocol dumps only here (ReadWritePaths= with
    # `-`, ignored when absent), and its sandbox cannot create the directory.
    (umask 077 && mkdir -p -- "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omdrop/debug") || true
    systemctl --user reset-failed "$UNIT" >/dev/null 2>&1 || true
    systemctl --user start "$UNIT"
  }

  if (( receiver_first )); then
    if ! start_receiver; then
      cancel_window
      identity_abort
      die "The AirDrop receiver would not start."
    fi
    if ! radio_up; then
      cancel_window
      systemctl --user stop "$UNIT" >/dev/null 2>&1
      [[ -x "$DISCOVERABLE" ]] && pkexec "$DISCOVERABLE" stop >/dev/null 2>&1 8>&-
      identity_abort
      die "${RADIO_ERR:-The AirDrop radio could not be started.}"
    fi
  else
    if ! radio_up; then
      cancel_window
      identity_abort
      die "${RADIO_ERR:-The AirDrop radio could not be started.}"
    fi
    if ! start_receiver; then
      cancel_window
      [[ -x "$DISCOVERABLE" ]] && pkexec "$DISCOVERABLE" stop >/dev/null 2>&1 8>&-
      identity_abort
      die "The AirDrop receiver would not start."
    fi
  fi

  # Receiving works from here, so this is where the clock the user set starts.
  # The radio's own deadline was set to the same span when the gate began, so
  # it now runs out a gate's worth of seconds early; ask it for the window
  # again so both ends agree on when this closes.
  case "$mode" in
    timed)
      systemd-run --user --quiet --on-active="$dur" --unit="$WINDOW" "$SELF" off --force \
        || die "receiving, but the $dur window could not be armed -- turn it off yourself"
      [[ -x "$DISCOVERABLE" ]] && pkexec "$DISCOVERABLE" start "$secs" >/dev/null 2>&1 8>&- ;;
  esac

  identity_unlock

  cmd_status
}

# Sends in progress, one marker per `omdrop send` process, naming where it
# is going. Turning Omdrop off takes the radio down, and a transfer cut off
# that way never closes on the other end: a Mac kept a 0-byte file "in use"
# and stopped accepting connections from this machine (2026-10-09).
SENDS_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omdrop/sends"
mark_sending() { (umask 077 && mkdir -p -- "$SENDS_DIR" && printf '%s\n' "$1" > "$SENDS_DIR/$$"); }
unmark_sending() { rm -f -- "$SENDS_DIR/$$"; }

# Where the live sends are going, one per line. A marker whose process has
# gone (killed, crashed) is cleared rather than believed.
sending_to() {
  local f pid
  for f in "$SENDS_DIR"/*; do
    [[ -e "$f" ]] || continue
    pid=${f##*/}
    if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
      cat -- "$f"
    else
      rm -f -- "$f"
    fi
  done
}

cmd_off() {
  local force=0 to
  case "${1:-}" in
    --force) force=1 ;;
    "") ;;
    *) die "off: no such option $1" ;;
  esac
  require_unit
  # A person asking for off while a send is running gets told, not obeyed.
  # The timers that close a window pass --force: nobody is there to ask.
  if (( ! force )); then
    to=$(sending_to | head -1)
    [[ -z "$to" ]] || die "Still sending to $to. Turning Omdrop off now would cut the transfer off. Cancel the send first, or turn it off anyway with: omdrop off --force"
  fi
  # Under the identity lock, in this order: nothing that starts later can
  # publish into this window; the receiver stops before the identity it loaded
  # is released; the window file goes last. See docs/identity-contract.md.
  identity_lock
  "$ID_PY" stop-begin
  systemctl --user stop "$UNIT" || die "The AirDrop receiver would not stop."
  cancel_window
  # Stop advertising even if the receiver was already down: the two can drift
  # apart when something else stopped one of them.
  [[ -x "$DISCOVERABLE" ]] && pkexec "$DISCOVERABLE" stop >/dev/null 2>&1 8>&-
  "$ID_PY" stop-end
  identity_unlock
  cmd_status
}

cmd_toggle() {
  require_unit
  if receiving; then cmd_off; else cmd_on "${1:-}"; fi
}

cmd_status() {
  local json=0
  [[ "${1:-}" == --json ]] && json=1
  local on=false left= vis=unknown mode=off
  receiving && on=true
  if [[ "$on" == true ]]; then
    # The watcher answers for every window it started. Without one -- it was
    # killed, or this receiver was started by hand -- the timer is all there is.
    mode=$(watch_mode) || mode=
    if [[ -z "$mode" ]]; then
      mode=forever
      systemctl --user is-active "$WINDOW.timer" >/dev/null 2>&1 && mode=timed
    fi
  fi
  left=$(window_remaining) || left=
  local reason= rxproven=0
  if [[ -x "$DISCOVERABLE" ]]; then
    vis=false
    local rs; rs=$("$DISCOVERABLE" status --json 2>/dev/null || true)
    # Anchored on the value, not "somewhere after the key": the old pattern
    # was *"visible":*true*, and {"visible":false,...,"rx_proven":true} matches
    # that -- the panel was shown as visible whenever any later field was true.
    [[ "$rs" == *'"visible":true'* ]] && vis=true
    reason=$(printf '%s' "$rs" | sed -n 's/.*"reason":"\([^"]*\)".*/\1/p')
    # rx_proven distinguishes a window the gate proved receive on from one it
    # opened on transmit alone. Both are live; only the wording differs.
    [[ "$rs" == *'"rx_proven":true'* ]] && rxproven=1 || rxproven=0
  fi

  if (( json )); then
    ON="$on" LEFT="$left" VIS="$vis" MODE="$mode" DIR="$(effective_dir)" \
    REASON="$reason" RXPROVEN="$rxproven" NAME="$(effective_name)" \
    AUDIENCE="$(cmd_visibility)" SENDERS="$(sender_count)" \
    SOUND="$(sound_on && echo 1)" python3 -c '
import json, os
left, vis = os.environ["LEFT"], os.environ["VIS"]
print(json.dumps({
    "receiving": os.environ["ON"] == "true",
    # null when the radio half is not installed: we genuinely do not know, and
    # the panel must not draw that as "yes".
    "visible": None if vis == "unknown" else vis == "true",
    "remaining": int(left) if left else None,
    "name": os.environ["NAME"] or None,
    "dir": os.environ["DIR"],
    "mode": os.environ["MODE"],
    "reason": os.environ["REASON"] or None,
    "rx_proven": os.environ["RXPROVEN"] == "1",
    "sound": os.environ["SOUND"] == "1",
    # Who may send: "everyone" or "contacts", with the allow-list size so the
    # panel can warn that an empty list refuses everybody.
    "visibility": os.environ["AUDIENCE"],
    "senders": int(os.environ["SENDERS"]),
}))'
    return
  fi

  if [[ "$on" != true ]]; then
    printf 'Not receiving\n'
    return
  fi
  # Same three windows the panel names, in the same words: a one-file window
  # has no clock to report, and calling it "until you turn it off" described
  # the wrong end condition.
  local window="until you turn it off"
  [[ "$mode" == once ]] && window="until one file arrives"
  [[ -n "$left" ]] && window=$(printf 'for %d:%02d minutes' $((left / 60)) $((left % 60)))
  # Name the audience, which is now true rather than aspirational: in contacts
  # mode a sender that identifies itself and is not on the list is refused at
  # /Discover, so it never sees this machine. Measured 2026-09-20: a Mac on an
  # unknown account got 401 to ten successive /Discover attempts and did not
  # appear in its own share sheet, while a listed account discovered and
  # transferred normally.
  #
  # The one caveat this line cannot carry is in the README: a device that sends
  # no identity record, or one we cannot verify, is still answered, because
  # "we could not tell who this is" must not become "hide from a device nobody
  # has tested against". Such a sender is still refused at /Ask.
  local audience='to everyone' empty=0
  if [[ "$(cmd_visibility)" == contacts ]]; then
    local known; known=$(sender_count)
    if (( known )); then
      audience=$(printf 'to %d known sender%s' "$known" "$( (( known == 1 )) || printf s )")
    else
      empty=1
    fi
  fi
  case "$vis" in
    true)
      if (( empty )); then
        printf 'Visible as "%s" %s, but nobody can send: contacts only, and the known-senders list is empty\n' \
          "$(effective_name)" "$window"
      else
        printf 'Visible %s as "%s" %s\n' "$audience" "$(effective_name)" "$window"
      fi ;;
    false)   printf 'Receiving as "%s" -- %s, but NOT visible: the radio side is not advertising\n' \
               "$(effective_name)" "$window" ;;
    unknown) printf 'Receiving as "%s" -- %s (cannot tell if anyone can see us: %s is missing)\n' \
               "$(effective_name)" "$window" "${DISCOVERABLE#$PROJ/}" ;;
  esac
}

# ------------------------------------------------------------------- sending
#
# Sending needs no service, no window and no state of our own: it is one
# outbound connection to a device the radio can already hear. What it does
# need is the radio, because the peer table the sender picks from is the
# firmware's, and that is filled while awdl0 is up.
#
# send-to-peer dials a peer's EUI-64 link-local address directly instead of
# browsing mDNS: an Apple device in Everyone mode answers /Discover while
# publishing no `_airdrop._tcp` instance at all, so a sender that waits for
# one waits forever. It drives airdrop-send.py over that endpoint.
require_sender() {
  [[ -x "$SENDER" ]] \
    || die "The program that sends files is not installed. It comes with the $(radio_pkg). $(radio_update)"
  awdl_link_local \
    || die "The Apple-compatible radio is not running, so nobody can be heard and nothing can be sent. Start it with: omdrop on 10m"
}

# Whether a window is open: awdl0 has its link-local address and the radio
# helper reports itself visible. The address alone outlives `omdrop off`. The
# helper's answer is read as JSON, so any valid spelling of it counts.
radio_on() {
  awdl_link_local || return 1
  [[ -x "$DISCOVERABLE" ]] || return 0
  "$DISCOVERABLE" status --json 2>/dev/null | python3 -c '
import json, sys
try:
    sys.exit(0 if json.load(sys.stdin).get("visible") is True else 1)
except (ValueError, AttributeError):
    sys.exit(1)'
}

# A driver older than 0.5.0 sends one file only. Its usage line is what says
# so, and asking it is cheaper than keeping a table of driver versions.
sender_takes_several_files() {
  "$SENDER" --help 2>&1 | grep -qF '[file ...]'
}

# Whether the installed driver package is at least the one this plugin pins.
# Read from pacman, because a helper fix is invisible from outside the helper.
driver_current() {
  local installed
  installed=$(pacman -Q "$DRIVER_PKG" 2>/dev/null) || return 1
  installed=${installed##* }
  version_ge "$installed" "$DRIVER_VERSION"
}

# What a send is of, in a few words: the file's name, or how many there are.
describe_files() {
  if (( $# == 1 )); then printf '%s' "${1##*/}"; else printf '%d files' "$#"; fi
}

# The sender speaks in debug log lines, deliberately: a transfer that goes
# wrong is a protocol problem and that log is how it gets diagnosed. Somebody
# sending a photo needs four sentences out of it, so this turns the lines that
# carry one into a sentence and drops the rest. `--verbose` prints the log
# untouched, which is what a bug report wants.
narrate_send() {
  local line rest name stat
  while IFS= read -r line; do
    case "$line" in
      *"; asking"*)             printf 'Asking them to accept it...\n' ;;
      *"ASK -> accepted"*)      printf 'They accepted. Sending...\n' ;;
      *"ASK -> declined"*)      printf 'They declined it.\n' >&2 ;;
      *"ASK failed: "*)         printf 'They never answered: %s\n' "${line#*ASK failed: }" >&2 ;;
      *"UPLOAD failed: "*)      printf 'The transfer failed: %s\n' "${line#*UPLOAD failed: }" >&2 ;;
      *"UPLOAD "*" -> FAILED"*) printf 'The transfer failed.\n' >&2 ;;
      *"UPLOAD "*" -> ok ("*)
        rest=${line#*UPLOAD }; name=${rest%% -> ok *}; stat=${line##*-> ok (}
        printf 'Sent %s (%s)\n' "$name" "${stat%)}" ;;
      # A link is delivered by the accepted Ask: there is no upload.
      *"LINK "*" -> ok"*)
        rest=${line#*LINK }; printf 'Sent %s\n' "${rest% -> ok}" ;;
    esac
  done
}

# Which device the files are going to, left in PEER. Takes the recipient,
# then the files, which only appear in the commands it suggests.
#
# Chosen here rather than left to the sender for two reasons. The sender's
# name for this is `--mac`, so its refusals ("several peers heard; choose one
# with --mac") name an option `omdrop send` does not have and send the reader
# in a circle. And an AWDL address is randomised per session -- nobody is
# going to read all six bytes off one listing and type them back -- so any
# unambiguous part of one is accepted here.
#
# A table that could not be read is NOT an empty room: reporting a helper that
# never ran as "nobody is nearby" sent a debugging session after the radio
# when the answer was polkit (send-to-peer's own lesson, 2026-09-18). Only its
# exit 1, "the table is empty", means an empty room.
PEER=

# Decimal seconds for named discovery. Strip leading zeros before arithmetic,
# and bound the input before conversion so oversized values cannot wrap.
NAME_WAIT=${OMDROP_NAME_WAIT:-120}
NAME_WAIT=${NAME_WAIT#"${NAME_WAIT%%[!0]*}"}
if [[ "$NAME_WAIT" =~ ^[0-9]{1,10}$ ]] && (( 10#$NAME_WAIT <= 2147483647 )); then
  NAME_WAIT=$(( 10#$NAME_WAIT ))
else
  NAME_WAIT=120
fi

# Keep answers across passes, but finish each pass before choosing: another
# device may have the same name. `listing` and `rc` belong to choose_peer.
find_by_name() {
  local want=$1 shown=$2 line mac name pid= found=0 other= note_at=0 left timed_out fd
  local deadline=$(( SECONDS + NAME_WAIT ))
  local -A row_of=() said=()
  trap '[[ -z "$pid" ]] || stop_group "$pid"; echo "Cancelled." >&2; exit 130' TERM INT HUP
  printf 'Looking for "%s" nearby (up to %ds)...\n' "$shown" "$NAME_WAIT"
  while :; do
    left=$(( deadline - SECONDS ))
    (( left > 0 )) || break
    other= timed_out=0
    # timeout bounds both the capability probe and the lookup, including a
    # child that closes its output but stays alive. Its session also contains
    # probes and Bluetooth advertising, so cancellation stops them together.
    # The two-second grace matches stop_group; neither wait can run forever.
    # peer_rows cleans the names and refuses a forged row (exit 65), so every
    # line read below, and every name printed from it, is already clean.
    exec {fd}< <(exec setsid timeout --kill-after=2 "$left" bash -c '
      sender=$1
      flags=()
      "$sender" --help 2>&1 | grep -- "--stream" >/dev/null && flags=(--stream)
      # Waits for the pipeline through a TERM, as the sender alone did when it
      # was exec-ed here: timeout KILLs only while its child is alive, and a
      # sender that outlives TERM must still get that KILL.
      trap : TERM
      set -o pipefail
      "$sender" --list --names "${flags[@]}" 2>&1 | python3 -c "$2" --text
    ' bash "$SENDER" "$PEER_ROWS_PY" 2>&1)
    pid=$!
    while :; do
      left=$(( deadline - SECONDS ))
      (( left > 0 )) || { timed_out=1; break; }
      IFS= read -r -t "$left" line <&"$fd" || { rc=$?; (( rc > 128 )) && timed_out=1; break; }
      if [[ "$line" =~ ^(([0-9a-f]{2}:){5}[0-9a-f]{2})[[:space:]]+(-?[0-9]+|\?)\ dBm[[:space:]]+[^[:space:]]+[[:space:]]*(.*)$ ]]; then
        mac=${BASH_REMATCH[1]}; name=${BASH_REMATCH[4]}
        # Keep an earlier answer if a later pass gets no response.
        [[ -n "${row_of[$mac]+x}" && "$name" == "(no response)" ]] || row_of[$mac]=$line
        case "$name" in
          ''|'(no response)'|'(anonymous)') ;;
          *)
            [[ -n "${said[$mac]+x}" ]] || { said[$mac]=1; printf 'Heard from %s.\n' "$name"; }
            [[ "${name,,}" == *"$want"* ]] && found=1 ;;
        esac
      else
        other+=$line$'\n'
      fi
    done
    if (( timed_out )); then
      stop_group "$pid"
      rc=1
    else
      wait "$pid"; rc=$?
      # GNU timeout returns 124, or 137 when its grace ends in SIGKILL.
      if (( SECONDS >= deadline && (rc == 124 || rc == 137) )); then timed_out=1; fi
    fi
    exec {fd}<&-
    pid=
    # A truncated pass cannot establish uniqueness, even if a match arrived.
    if (( timed_out )); then
      die "Name lookup did not finish within $NAME_WAIT seconds; nothing was sent. Open AirDrop on \"$shown\" and try again.
${other}Answers so far:
$(printf '  %s\n' "${row_of[@]}")"
    fi
    # Only exit 1 means an empty table; other failures need attention now.
    (( rc == 0 || rc == 1 )) || die "${other%$'\n'}"
    (( found )) && break
    left=$(( deadline - SECONDS ))
    (( left > 0 )) || break
    if (( SECONDS >= note_at )); then
      printf 'No "%s" yet (devices heard: %d, named: %d). Still looking, %ds left...\n' \
        "$shown" "${#row_of[@]}" "${#said[@]}" "$left"
      note_at=$(( SECONDS + 15 ))
    fi
    # A fast empty pass must not spin, or sleep past the remaining budget.
    (( left > 3 )) && left=3
    setsid sleep "$left" &
    pid=$!
    wait "$pid"
    pid=
  done
  trap - TERM INT HUP
  listing=$(printf '%s\n' "${row_of[@]}")
  (( ${#row_of[@]} )) && rc=0 || rc=1
}

choose_peer() {
  local want=${1,,} shown=$1 listing rc rows=() matches=() exact=() row lines= quoted by_name=0; shift
  # A colon, or a full 12-hex MAC, is an address. Anything else is a device
  # name -- and the test has to be that strict, because device names are often
  # pure hex ("f0011" is one here) and treating such a name as an address
  # fragment would silently pick the wrong machine.
  if [[ -n "$want" && "$want" != *:* && ! "$want" =~ ^[0-9a-f]{12}$ ]]; then by_name=1; fi
  # Names cost a connection per peer, so they are only asked for when a name
  # is what was given. A device answers with its name only while it is
  # receiving -- which is exactly the case here, since it has to be receiving
  # to accept the file anyway.
  if (( by_name )); then
    find_by_name "$want" "$shown"
  else
    listing=$("$SENDER" --list 2>&1); rc=$?
  fi
  (( rc == 0 || rc == 1 )) || die "$listing"
  mapfile -t rows < <(printf '%s\n' "$listing" \
    | sed -nE 's/^(([0-9a-f]{2}:){5}[0-9a-f]{2})[[:space:]]+(-?[0-9]+|\?) dBm[[:space:]]+[^[:space:]]+[[:space:]]*(.*)$/\1|\3|\4/p')
  if (( ${#rows[@]} == 0 )); then
    (( by_name )) && die "No Apple device was heard in $NAME_WAIT seconds. Open AirDrop on \"$shown\" so it can be heard, then try again."
    die "No nearby Apple device found. A window is what finds them, so open one first:  omdrop on 10m"
  fi

  for row in "${rows[@]}"; do
    local mac=${row%%|*} rest=${row#*|} name
    name=${rest#*|}; name=${name,,}
    if [[ -z "$want" ]]; then matches+=("$row")
    elif (( by_name )); then
      [[ "$name" == *"$want"* && "$name" != "(no response)" && "$name" != "(anonymous)" ]] && matches+=("$row")
      [[ "$name" == "$want" ]] && exact+=("$row")
    else
      [[ "$mac" == *"$want"* ]] && matches+=("$row")
    fi
  done
  # Prefer an exact name, but still refuse two devices with that exact name.
  (( ${#exact[@]} )) && matches=("${exact[@]}")
  if (( ${#matches[@]} == 0 )); then
    if (( by_name )); then
      die "No device called \"$shown\" answered in $NAME_WAIT seconds. A device gives its name
only while it is ready to receive, so open AirDrop on it and try again. What answered:
$(printf '%s\n' "$listing" | sed 's/^/  /')"
    fi
    die "No device matching \"$want\" was found. See what is nearby:  omdrop peers"
  fi
  if (( ${#matches[@]} > 1 )); then
    # Each line is the command to run, not a description of one: the files are
    # already in hand, and the address is six random bytes nobody should have
    # to retype.
    printf -v quoted ' %q' "$@"
    for row in "${matches[@]}"; do
      local m=${row%%|*} r=${row#*|}; local rssi=${r%%|*} nm=${r#*|}
      lines+="
  omdrop send --to $m$quoted   (${rssi} dBm${nm:+, $nm})"
    done
    die "${want:+Several devices match \"$want\"}${want:-Several Apple devices were found}. Choose one:$lines"
  fi
  # Strongest signal first, because that is the order --list reports in: with
  # one match this is simply it.
  PEER=${matches[0]%%|*}
}

cmd_send() {
  local to= wait=$DEFAULT_SEND_WAIT verbose=0 pick=0 rc f url; local -a rest=() files=() urls=()
  while (( $# )); do
    case "$1" in
      --to)     shift; (( $# )) || die "send --to: the address of a device, as listed by: omdrop peers"; to=$1 ;;
      --to=*)   to=${1#--to=} ;;
      --wait)   shift; (( $# )) || die "send --wait: a number of seconds"; wait=$1 ;;
      --wait=*) wait=${1#--wait=} ;;
      -v|--verbose) verbose=1 ;;
      # The panel's route: ask for the files in a chooser, after everything
      # that could refuse the send has been checked, so nobody picks files
      # only to be told the radio is off.
      --pick)   pick=1 ;;
      # A filename may begin with a dash, and the person holding it should not
      # have to know that; `--` is how they say so.
      --)       shift; break ;;
      -*)       die "send: no such option $1" ;;
      # Collected first, sorted afterwards: which positional is a file and
      # which is the recipient is decided by the filesystem, not by position,
      # so `omdrop send fred photo.jpg` and `omdrop send photo.jpg fred` both
      # work. Someone reaching for this should not have to recall an order.
      *)        rest+=("$1") ;;
    esac
    shift
  done
  rest+=("$@")
  # Web links are payloads, not recipients. With --to, every other argument
  # is a file. Without it, one nonexistent path can name the recipient.
  local -a absent=()
  for f in "${rest[@]}"; do
    if web_url "$f"; then urls+=("$f")
    elif [[ -n "$to" || -e "$f" ]]; then files+=("$f")
    else absent+=("$f")
    fi
  done
  case ${#absent[@]} in
    0) ;;
    1) to=${absent[0]} ;;
    *) die "send: none of these is a file, and only one can be the recipient: ${absent[*]}" ;;
  esac

  if (( pick )); then
    (( ${#rest[@]} == 0 )) || die "send --pick: the chooser picks the files, so name only the recipient, with --to"
    require_sender
    # NUL-separated, because a filename may hold a newline. Through a file
    # rather than $(...), which cannot carry a NUL, so the chooser's exit
    # status still decides.
    local chosen; chosen=$(mktemp) || die "omdrop could not create a temporary file."
    pick files "$(send_start_dir)" "Send to ${to:-a nearby device}" > "$chosen"
    rc=$?
    mapfile -d '' -t files < "$chosen"
    rm -f "$chosen"
    (( rc == 0 )) || exit "$rc"
    (( ${#files[@]} )) || exit 1
    # Remembered on choosing, not on arriving: the folder is where they
    # keep things to send, whether or not these got through.
    setting_set send_from "$(dirname "${files[0]}")"
    # The first line the panel hears: the chooser has closed with files, so
    # the panel can come back and show this send's progress.
    printf 'Preparing %s...\n' "$(describe_files "${files[@]}")"
  fi

  # Send a shortcut's web link rather than upload the shortcut as a file.
  # Invalid shortcuts and non-web links remain ordinary files.
  local -a kept=() link_notes=()
  for f in "${files[@]}"; do
    if is_link_file "$f" && url=$(link_target "$f"); then
      urls+=("$url")
      link_notes+=("Sending the link in ${f##*/}, so it opens in their browser: $url")
    else
      kept+=("$f")
    fi
  done
  files=("${kept[@]}")
  (( ${#urls[@]} == 0 || ${#files[@]} == 0 )) \
    || die "Send links and files separately: one transfer carries one or the other."
  (( ${#link_notes[@]} == 0 )) || printf '%s\n' "${link_notes[@]}"

  (( ${#files[@]} + ${#urls[@]} )) || die "usage: omdrop send [RECIPIENT] FILE...|URL... [--wait SECONDS]
  RECIPIENT is a device name, as shown by \`omdrop peers -n\`, or part of an address.
  A URL is an http or https link, which opens in the recipient's browser."
  local -a names=()
  local n
  for f in "${files[@]}"; do
    [[ -e "$f" ]] || die "$f: there is no such file"
    [[ ! -d "$f" ]] || die "$f: a folder cannot be sent -- send files, or compress the folder first"
    [[ -f "$f" && -r "$f" ]] || die "$f: not a file that can be read"
    # The device stores each file under its name alone, so two files of one
    # name would arrive as one. Said here, before anyone waits on a device.
    # A list, not an associative array: a filename such as "@" is not a safe
    # subscript.
    for n in "${names[@]}"; do
      [[ "$n" != "${f##*/}" ]] \
        || die "Two of these files are called $n, and the device would keep only one. Rename one, or send them separately."
    done
    names+=("${f##*/}")
  done

  # Checked here rather than left to the sender, so a typo costs a sentence
  # instead of a polkit prompt and a Python traceback.
  [[ "$wait" =~ ^[0-9]+$ ]] \
    || die "send --wait: whole seconds, or 0 to give up the moment the device refuses a connection"
  # A recipient is either a device NAME or part of an address. Both are passed
  # through untouched: the sender decides which it is, using the same rule --
  # a colon or a full 12-hex MAC is an address, anything else is a name -- and
  # duplicating that judgement here is how the two would drift apart.
  #
  # Names are not lowercased either. The sender matches case-insensitively,
  # and folding the case here would only corrupt the message it prints back.
  if [[ -n "$to" ]]; then
    [[ "$to" != *$'\n'* ]] || die "send: a recipient is one name or address, not several lines"
  fi
  [[ -x "$SENDER" ]] \
    || die "The program that sends files is not installed. It comes with the $(radio_pkg). $(radio_update)"
  # The driver package owns the sender, and a driver older than this plugin
  # takes one file only. Say so, rather than surface its argparse error.
  if (( ${#files[@]} > 1 )) && ! sender_takes_several_files; then
    die "Sending several files at once needs a newer $(radio_pkg). $(radio_update)"
  fi
  if (( ${#urls[@]} )) && ! "$SENDER" --help 2>&1 | grep -q -- '--url'; then
    die "Sending a link needs a newer $(radio_pkg). $(radio_update)"
  fi

  # A closed window hears nobody, so a send to a named device opens one, as
  # the panel's Send section does, for the usual window. A send without a
  # name needs the window open first: in a window just opened, "the only
  # device heard" is whichever device spoke first.
  if ! radio_on; then
    local example; printf -v example ' %q' "${urls[@]}" "${files[@]}"
    [[ -n "$to" ]] || die "Omdrop is off, so no device can be heard. Name the device, and omdrop turns itself on to find it:
  omdrop send NAME$example
Or turn it on first, with: omdrop on"
    printf 'Omdrop is off. Turning it on for %s, so nearby devices can be heard...\n' "$DEFAULT_WINDOW"
    "$SELF" on >/dev/null || die "Omdrop could not be turned on, so nothing was sent."
    radio_on || die "Omdrop turned on, but the radio is not up yet, so nothing was sent. Try again in a few seconds."
    printf 'Omdrop is on, and visible nearby until the window ends. Turn it off sooner with: omdrop off\n'
  fi

  choose_peer "$to" "${urls[@]}" "${files[@]}"

  # The name Apple devices already know this computer by. The prompt on their
  # screen should say the same thing whichever way the file is going, and the
  # sender's own default ("Omarchy") is nobody's machine in particular.
  local -a link_args=()
  for url in "${urls[@]}"; do link_args+=(--url "$url"); done
  local cmd=("$SENDER" --name "$(effective_name)" --wait "$wait" --mac "$PEER" "${link_args[@]}" -- "${files[@]}")

  # Until this process exits, `omdrop off` knows a transfer is running.
  mark_sending "${to:-$PEER}" || true
  trap unmark_sending EXIT

  if (( verbose )); then
    # Verbose is for bug reports: the protocol log, and redacted dumps of each
    # request and answer in the runtime directory (docs/identity-contract.md).
    OMDROP_DEBUG=1 run_cancellable "${cmd[@]}"
    return
  fi
  run_cancellable send_narrated
}

# PIPESTATUS, not $?: the narrator always succeeds, and the answer to "did
# the file arrive" is the sender's exit status. Reads `cmd` from cmd_send.
# The sender's complaints go through send_errors on their way to stderr; the
# wait is for that filter, so its last line is out before the panel reads it.
send_narrated() {
  local rc
  "${cmd[@]}" 2> >(send_errors >&2) | narrate_send
  rc=${PIPESTATUS[0]}
  wait "$!" 2>/dev/null
  return "$rc"
}

# The sender's "<address> never opened 8770; on an iPhone, open a share
# sheet..." names a port and a macOS daemon. What the person can act on
# depends on the identity this computer is sending with: a self-signed one
# only reaches devices set to Everyone.
send_errors() {
  local line
  while IFS= read -r line; do
    case "$line" in
      *" never opened "*) unreachable_message ;;
      *) printf '%s\n' "$line" ;;
    esac
  done
}

unreachable_message() {
  local window mode
  read -r window mode < <("$ID_PY" status --json 2>/dev/null | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except ValueError:
    d = {}
print(d.get("window") or "-", d.get("mode") or "-")' 2>/dev/null)
  if [[ "$window" == self-signed && "$mode" == 1password ]]; then
    printf '%s\n' '1Password locked; using self-signed certificates. Peers must be in "Everyone" mode.'
  elif [[ "$window" == self-signed ]]; then
    printf '%s\n' 'Using self-signed certificates. Peers must be in "Everyone" mode.'
  else
    printf '%s\n' 'It is not accepting files right now. On an iPhone, open a share sheet to wake AirDrop, then try again.'
  fi
}

stop_group() {
  local g=$1 i
  kill -TERM -- "-$g" 2>/dev/null || return 0
  for i in $(seq 20); do
    kill -0 -- "-$g" 2>/dev/null || break
    sleep 0.1
  done
  kill -KILL -- "-$g" 2>/dev/null
  wait "$g" 2>/dev/null
}

# Cancelling a send has to stop the sender, not just this script. Killed
# while waiting on a pipeline, bash dies and leaves its children running, so
# a cancelled send went on knocking on the device's door, and would still
# have delivered the file if the door opened. The send runs as its own
# process group instead, and a TERM, INT or HUP here takes the whole group
# down before saying so.
#
# TERM first, so the sender can take its Bluetooth advert down itself, then
# KILL whatever is left. The sender does not always exit on TERM: measured
# 2026-09-23, a lookup given TERM stopped advertising but went on starting
# probes for as long as it had peers to ask.
run_cancellable() {
  local pid rc
  set -m
  "$@" &
  pid=$!
  set +m
  trap 'stop_group "$pid"; echo "Cancelled." >&2; exit 130' TERM INT HUP
  wait "$pid"
  rc=$?
  trap - TERM INT HUP
  return "$rc"
}

# Run any slow command with a live "still working" line, so a wait that is
# working is not mistaken for one that has hung.
#
# The animation goes to /dev/tty, NOT to stdout or stderr. Both of those are
# captured somewhere in this script -- `peers` reads the listing off stdout,
# `on` reads the helper's complaint off stderr -- and a spinner frame in
# either would end up parsed as data or printed back at the person later.
# /dev/tty is the terminal the human is actually looking at, and when there is
# none (a pipe, a service, a test) the command simply runs with no animation.
#
# The command keeps this shell's stdout and stderr, so output still streams and
# $(...) still captures it; only the frames are diverted. Callers that want the
# output should capture the call exactly as they would have without this.
#
# Braille frames because they are one column wide in every terminal font we
# have; a multi-column glyph leaves droppings when the line is erased.
# The verbs rotate every few seconds. That is not decoration: a frame that
# spins but never changes its words looks the same whether the command is
# working or wedged, and the elapsed counter beside them is the thing that
# actually answers "is this hung". Keep them short, gerunds, and honest about
# the fact that we are waiting on somebody else's radio.
SPINNER_VERBS=(Hollering Eavesdropping Doorknocking Wheedling Coaxing
               Cajoling Rummaging Earwigging Loitering Dowsing
               Beachcombing Wittering Pestering Hobnobbing)

spinner_while() {
  local label=$1; shift
  # Opening it, not testing its mode: /dev/tty is a character device with
  # world write permission whether or not this process HAS a controlling
  # terminal, so `[[ -w /dev/tty ]]` is true inside a daemon or a test harness
  # and every frame then fails with "No such device or address".
  { : >/dev/tty; } 2>/dev/null || { "$@"; return $?; }
  local frames='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏' i=0 pid rc start now verb
  local v=$(( RANDOM % ${#SPINNER_VERBS[@]} ))
  "$@" &
  pid=$!
  start=$SECONDS
  # Erase the line and put the cursor back however this ends, including a
  # Ctrl-C that takes the shell down mid-frame. A hidden cursor left behind
  # outlives the command and breaks the terminal the person keeps using.
  trap 'printf "\r\033[K\033[?25h" >/dev/tty 2>/dev/null' EXIT INT TERM
  printf '\033[?25l' >/dev/tty
  while kill -0 "$pid" 2>/dev/null; do
    now=$(( SECONDS - start ))
    verb=${SPINNER_VERBS[ (v + now / 4) % ${#SPINNER_VERBS[@]} ]}
    printf '\r\033[K%s %s… (%ds · %s)' \
           "${frames:i++%${#frames}:1}" "$verb" "$now" "$label" >/dev/tty
    sleep 0.1
  done
  wait "$pid"; rc=$?
  printf '\r\033[K\033[?25h' >/dev/tty
  trap - EXIT INT TERM
  return "$rc"
}

cmd_peers() {
  # -n is opt-in because asking a peer its name means connecting to it, which
  # shows this machine to every device listed. A bare `omdrop peers` stays
  # passive: it reads the firmware peer table and transmits nothing.
  #
  # -n also raises a BLE advert carrying this account's contact hashes for the
  # few seconds the lookup runs, because a Contacts Only device keeps its
  # AirDrop server shut until it recognizes one -- without it, names resolve
  # only from devices something else has woken. --no-wake asks for the lookup
  # without that broadcast.
  local names=() wake=() json=0 stream=0
  while (( $# )); do
    case "$1" in
      -n|--names) names=(--names); shift ;;
      --no-wake) wake=(--no-wake); shift ;;
      --json) json=1; shift ;;
      --stream) stream=1; shift ;;
      *) die "usage: omdrop peers [-n|--names] [--no-wake] [--json] [--stream]" ;;
    esac
  done
  (( ! stream )) || { (( json )) && (( ${#names[@]} )); } \
    || die "omdrop peers: --stream is for the panel and needs --json -n"
  require_sender
  # The driver package owns the sender, and the two are versioned independently, so
  # a plugin newer than the installed driver would otherwise hand a flag to a
  # tool that has never heard of it and surface raw argparse output. Say what
  # is actually wrong instead.
  if (( ${#names[@]} )) && ! "$SENDER" --help 2>&1 | grep -q -- '--names'; then
    die "Looking up peer names needs a newer $(radio_pkg). $(radio_update)"
  fi
  # --stream: one JSON object per peer on its own line, so the panel shows a
  # name seconds after it arrives rather than when the whole lookup ends. The
  # lookup still runs as its own process group, so stopping this command
  # stops the sender and its advert. A driver too old for --stream gives the
  # same lines, all at the end.
  #
  # A row is written the moment that peer answers only when the sender keeps
  # each peer on one line (sender_names_clean). From any other sender, a name
  # with a line break in it can forge a row that is only found out when its
  # address comes round again, and by then the panel would have shown it; so
  # the rows are held until the sender exits and all of them have passed.
  if (( stream )); then
    local sflag=() early=()
    "$SENDER" --help 2>&1 | grep -q -- '--stream' && sflag=(--stream)
    sender_names_clean && early=(--early)
    peers_stream() { "$SENDER" --list "${names[@]}" "${wake[@]}" "${sflag[@]}" | peer_rows --lines "${early[@]}"; }
    run_cancellable peers_stream
    return
  fi
  # An empty peer table has two causes and the sender cannot tell them apart:
  # no window is open, or a window is open and no device has been found. Only
  # the first is something the person can act on, so decide it here, where the
  # window state is known, rather than printing one sentence for both.
  local out rc
  # The listing itself, for run_cancellable. Reads names and wake from cmd_peers.
  peers_lookup() { "$SENDER" --list "${names[@]}" "${wake[@]}" > "$1"; }
  # Naming takes fifteen to twenty seconds: the advert has to be recognized,
  # the peer has to start its AirDrop server, and the first /Discover is
  # usually killed by that server's own restart and retried. Measured 15.5-17.6
  # s per call on 2026-09-21. Silence that long reads as a hang. A bare listing
  # transmits nothing and returns at once, so it gets no animation.
  # The panel asks for JSON and draws its own progress, so it gets no spinner
  # (and has no terminal for one anyway).
  #
  # A named lookup transmits for as long as it runs, so it must stop when
  # this command is stopped. The panel ends one every time its section closes,
  # and a bare kill of this script left the sender and its Bluetooth advert
  # running, orphaned: they piled up alongside the next lookup, several
  # adverts and connection bursts at once, and names stopped resolving. So the
  # lookup runs as its own process group, like a send, and writes its answer
  # to a file this shell reads once it has finished.
  # A global, not a local: the EXIT trap runs after this function returns.
  PEERS_TMP=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/omdrop-peers.XXXXXX") || die "could not make a temporary file"
  trap 'rm -f "$PEERS_TMP"' EXIT
  if (( ${#names[@]} && ! json )); then
    run_cancellable spinner_while "Asking nearby devices for their names" \
      peers_lookup "$PEERS_TMP"; rc=$?
  else
    run_cancellable peers_lookup "$PEERS_TMP"; rc=$?
  fi
  out=$(<"$PEERS_TMP")
  if (( json )); then
    # An empty room is still an answer the panel can draw: `[]` on stdout, and
    # the same exit status and sentence as the text form on stderr.
    if (( rc == 1 )); then printf '[]\n'
    elif (( rc == 0 )); then printf '%s\n' "$out" | peer_rows --json || exit 1; return 0
    else die "$(printf '%s\n' "$out" | peer_rows --text)"
    fi
  fi
  # Whole, before any of it is printed: a forged row refuses the listing.
  out=$(printf '%s\n' "$out" | peer_rows --text) || exit 1
  if (( rc == 1 )); then
    # The RADIO, not the receiver: the receiver can be up with no window open,
    # and it is the window that runs the peer watcher which fills this table.
    if [[ "$("$DISCOVERABLE" status --json 2>/dev/null)" != *'"visible":true'* ]]; then
      die "Omdrop is currently OFF. Turn it on to see peers."
    fi
    # A window IS open, so the sender's advice to open one is stale. Say the
    # one thing that is true: nobody is there yet. Peers appear as they
    # transmit, which for a Mac or iPhone means opening its share sheet.
    die "No devices found yet. Open the AirDrop sheet on the device you want to see, then run this again."
  fi
  printf '%s\n' "$out"
  return "$rc"
}

# The sender's listing, read the way choose_peer reads it: address, signal (or
# `?`), endpoint, then a name column that -n fills. A name is whatever a
# nearby device chose to call itself, so it is cleaned before anything prints
# or matches it, by the rule omdrop-core's sender applies: no C0 or C1
# controls, DEL, line or paragraph separators, bidi controls or zero-width
# characters, at most 255 UTF-8 bytes, no surrounding whitespace. Lines end at
# \n only, never at a \r, so the rows bash sees are the rows parsed here.
#
# Each whole line is cleaned before its shape is judged: a forged row behind
# an escape or an invisible character would otherwise pass here as some other
# line, and become a row once cleaned. A line that still is not a row but
# holds " dBm" is printed indented, so nothing reading the output further on
# can take it for one.
#
# One lookup lists each address once. An address listed twice means a name
# held a line break that the sender passed on, and the text after it posed as
# a row of its own: possibly another device's address with a name of the
# sender's choosing. There is no telling the forged row from the real one, so
# the listing is refused: a message on stderr and exit 65, with nothing
# further printed.
#
#   --text   the listing, cleaned; other lines kept, cleaned the same way
#   --json   one JSON array, for `peers --json`
#   --lines  one JSON object per row, for the panel's stream: all of them once
#            the lookup has ended and none was forged, or, with --early, each
#            as it arrives (for a sender that keeps each peer on one line)
# The placeholders a lookup prints for a peer that did not answer are not
# names, so they become null rather than labels on the radar.
PEER_ROWS_PY='
import json, re, sys
mode = sys.argv[1]
early = sys.argv[2:] == ["--early"]
row = re.compile(r"((?:[0-9a-f]{2}:){5}[0-9a-f]{2})\s+(-?[0-9]+|\?) dBm\s+\S+\s*")
unsafe = re.compile("[\x00-\x1f\x7f-\x9f\u200b-\u200f\u2028-\u202e\u2066-\u2069\ufeff]")
# Unicode White_Space, as omdrop-core trims it.
space = "\t\n\x0b\x0c\r \x85\xa0\u1680\u2028\u2029\u202f\u205f\u3000" + "".join(map(chr, range(0x2000, 0x200B)))

def clean(name):
    name = unsafe.sub("", name).encode()[:255].decode("utf-8", "ignore")
    return name.strip(space)

seen, peers, forged = set(), [], False
# readline, not iteration: each line is passed on as soon as it arrives.
for raw in iter(sys.stdin.buffer.readline, b""):
    if forged:
        continue
    line = unsafe.sub("", (raw[:-1] if raw.endswith(b"\n") else raw).decode("utf-8", "replace"))
    m = row.match(line)
    if not m:
        if mode == "--text":
            print("  " + line if " dBm" in line else line, flush=True)
        continue
    if m.group(1) in seen:
        # Read to the end, so the lookup finishes as it would have.
        print(f"{m.group(1)} was listed twice in one lookup: a nearby device sent a name with a "
              "line break in it, which can pass one device off as another. Nothing from this "
              "lookup was used. Look again in a moment.", file=sys.stderr, flush=True)
        forged = True
        continue
    seen.add(m.group(1))
    name = clean(line[m.end():])
    if mode == "--text":
        head = line[:m.end()]
        print(head + name if name else head.rstrip(space), flush=True)
        continue
    peer = {
        "mac": m.group(1),
        "rssi": None if m.group(2) == "?" else int(m.group(2)),
        "name": None if name in ("", "(no response)", "(anonymous)") else name,
    }
    if mode == "--lines" and early:
        print(json.dumps(peer), flush=True)
    else:
        peers.append(peer)
if forged:
    sys.exit(65)
if mode == "--json":
    print(json.dumps(peers))
elif mode == "--lines":
    for peer in peers:
        print(json.dumps(peer), flush=True)
'
peer_rows() { python3 -c "$PEER_ROWS_PY" "$@"; }

# The unit is hardened with ProtectHome=read-only, so the download folder has
# to be named in ReadWritePaths or the receiver cannot write there. Rather than
# drop the hardening, keep the unit honest and write a drop-in naming exactly
# the folder in use -- the unit's own header asks for this.
# Follow the receiver's own log rather than the folder: it names the files it
# stored, and an unrelated download landing there cannot fool it. Only the
# receiver's own two records count, matched whole, and only names that are
# regular files directly inside the download folder are acted on: a sender's
# text can reach the log, and must never point this at anything else.
cmd_watch() {
  local once=0
  while (( $# )); do
    case "$1" in
      --once)   once=1; shift ;;
      # Declaration only: `status` reads the window's span off this unit's
      # arguments, and the deadline itself is a systemd timer.
      --window) shift; (( $# )) && shift ;;
      *)        shift ;;
    esac
  done
  local dir; dir=$(effective_dir)
  # Handlers run here when systemd-run fails, across every record of an
  # upload the receiver split: a one-file window waits for all of them.
  local inline=()
  echo "omdrop watch: following $UNIT, saving into $dir"
  journalctl --user -u "$UNIT" -f -n 0 -o cat 2>/dev/null | arrival_names "$dir" \
    | while IFS=/ read -r -a fields; do
    local state=${fields[0]-} names=("${fields[@]:1}") name f
    for name in "${names[@]}"; do
      f="${dir%/}/$name"
      echo "omdrop watch: announcing $f"
      # In its own transient unit, like `off` below: stopping this service
      # (`off`, or a one-file window closing right after this) kills its whole
      # cgroup, and a notification still decoding its preview would be lost.
      # systemd-run returns once the unit has started. Without it, handle runs
      # here, and a one-file window waits for it before closing. MemoryMax
      # bounds what decoding a sender's photo for its preview can take.
      if ! systemd-run --user --quiet --collect -p MemoryMax=512M "$SELF" handle "$f" >/dev/null 2>&1; then
        "$SELF" handle "$f" &
        (( once )) && inline+=("$!")
      fi
    done
    if (( once )) && [[ "$state" == done ]]; then
      (( ${#inline[@]} )) && wait "${inline[@]}"
      # In its OWN transient unit, not in this process. `off` calls
      # cancel_window, which stops omdrop-watch.service -- this service -- and
      # systemd kills the whole cgroup, so an in-process `off` was killed
      # partway through and the receiver stayed up. Observed twice on
      # 2026-09-17: a one-file window announced its file, closed the watcher,
      # and left the receiver listening, which then accepted a second file.
      # --collect so the unit does not linger once it has exited.
      systemd-run --user --quiet --collect "$SELF" off --force >/dev/null 2>&1 \
        || "$SELF" off --force >/dev/null 2>&1
      return 0
    fi
  done
}

# The files one of the receiver's records says it stored, read off its log on
# stdin, by the rules omdrop-core's links.rs applies (arrivals, arrived_file).
# A record is the receiver's own `%(asctime)s INFO root: ` prefix, then one of
#   upload TID: stored NAME          an upload of one file (or none: no NAME)
#   upload TID (K/N): stored NAME    file K of an upload of N, K = 1..N
#   link stored as NAME.url -> http(s)://...
# and anything else is not one, however much of it matches. Everything after
# `: stored ` is one name, whatever it holds: names are never split, since a
# name may itself hold ", ", and splitting one could name a different file
# that happens to exist. ` (K/N)` sits where no file name can. A name counts
# only if it is a plain file name -- no slash, no leading dot, no control
# character -- naming a regular file directly in the download folder $1, by
# lstat, so a symlink planted there is not followed.
#
# Prints a line per record that named a file or ended a transfer: `more` or
# `done`, then the record's file name, if any, joined by `/`, which no name
# can hold. `done` marks the last record of a transfer that named a file in
# any of its records: the plain form, a link, or K = N. A name that is not a
# file is reported on stderr.
arrival_names() {
  python3 -c '
import os, re, signal, stat, sys
signal.signal(signal.SIGPIPE, signal.SIG_DFL)
folder = sys.argv[1]
prefix = re.compile(r"[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2},[0-9]{3} INFO root: ")
upload = re.compile(r"([A-Za-z0-9._-]{1,64})(?: \(([1-9][0-9]*)/([1-9][0-9]*)\))?")
# Unicode White_Space, which is what Rust calls whitespace.
space = set("\t\n\x0b\x0c\r \x85\xa0\u1680\u2028\u2029\u202f\u205f\u3000")
space.update(map(chr, range(0x2000, 0x200B)))

def control(c):
    return c < "\x20" or "\x7f" <= c <= "\x9f"

def arrivals(line):
    """(transfer, whether this record is its last, its name or ""), or None."""
    m = prefix.match(line)
    if not m:
        return None
    msg = line[m.end():]
    if msg.startswith("upload "):
        head, sep, name = msg[len("upload "):].partition(": stored ")
        u = upload.fullmatch(head)
        if not sep or not u:
            return None
        if u.group(2) is None:
            return u.group(1), True, name
        k, n = int(u.group(2)), int(u.group(3))
        if k > n or n > 512:
            return None
        return u.group(1), k == n, name
    if not msg.startswith("link stored as "):
        return None
    name, sep, url = msg[len("link stored as "):].partition(" -> ")
    if not sep or len(name) <= 4 or not name.endswith(".url") or " " in name or "/" in name:
        return None
    for scheme in ("https://", "http://"):
        if url.startswith(scheme):
            rest = url[len(scheme):]
            break
    else:
        return None
    if not rest or any(c in space for c in rest):
        return None
    return None, True, name

def arrived(name):
    if not name or "/" in name or name.startswith(".") or any(map(control, name)):
        return False
    try:
        return stat.S_ISREG(os.lstat(os.path.join(folder, name)).st_mode)
    except OSError:
        return False

# Transfers whose earlier records named a file, until their last record.
announced = set()
for raw in iter(sys.stdin.buffer.readline, b""):
    try:
        line = raw[:-1].decode() if raw.endswith(b"\n") else raw.decode()
    except UnicodeDecodeError:
        continue
    record = arrivals(line)
    if record is None:
        continue
    tid, last, name = record
    found = arrived(name)
    if name and not found:
        print(f"omdrop watch: receiver named \x27{name}\x27, which is not a file in {folder}; ignored",
              file=sys.stderr, flush=True)
    done = last and (found or tid in announced)
    if tid is not None:
        if last:
            announced.discard(tid)
        elif found:
            announced.add(tid)
    if found or done:
        print("/".join(["done" if done else "more"] + ([name] if found else [])), flush=True)' "$1"
}

# The URL inside an Apple .webloc or a Windows .url shortcut, unchecked. Both
# are what an Apple device sends when you share a link rather than a file, and
# the receiver stores a link it is handed directly as a .url.
#
# .url: the first URL= in the [InternetShortcut] section, CR stripped, because
# a Windows-written file has CRLF lines and a URL= elsewhere is not the link.
# .webloc: the URL key of a property list, XML or binary -- macOS writes both.
# Capped at 64 KiB: these arrive from whoever is nearby, and a real one is a
# few hundred bytes.
link_url() {
  local f=$1
  [[ -f "$f" && -r "$f" ]] || return 1
  (( $(stat -c %s -- "$f" 2>/dev/null || echo 65537) <= 65536 )) || return 1
  case "${f,,}" in
    *.url)
      awk '
        { sub(/\r$/, "") }
        /^[ \t]*\[/ { s = tolower($0); gsub(/[ \t]/, "", s); in_section = (s == "[internetshortcut]"); next }
        in_section && tolower($0) ~ /^[ \t]*url[ \t]*=/ {
          sub(/^[^=]*=[ \t]*/, ""); sub(/[ \t]+$/, ""); print; exit
        }' "$f" ;;
    *.webloc)
      python3 -c '
import plistlib, sys
try:
    with open(sys.argv[1], "rb") as fh:
        url = plistlib.load(fh).get("URL")
except Exception:
    sys.exit(1)
if isinstance(url, str):
    print(url.strip())' "$f" ;;
    *) return 1 ;;
  esac
}

# Whether a URL is a web page, the only kind Omdrop opens. A received link can
# name file://, smb://, or an app's custom scheme, and it was chosen by
# whoever is nearby, so everything else is refused before anything launches.
web_url() {
  local u=$1 l=${1,,} rest
  [[ "$l" == http://* || "$l" == https://* ]] || return 1
  [[ "$u" != *[[:space:][:cntrl:]]* ]] || return 1
  rest=${l#*://}
  [[ -n "$rest" && "$rest" != /* ]]
}

# The web link in a link file, or nothing and a failure. Every caller that
# opens or copies a link goes through here, so there is one gate.
link_target() {
  local url
  url=$(link_url "$1") && web_url "$url" && printf '%s\n' "$url"
}

is_link_file() { case "${1,,}" in *.url|*.webloc) return 0 ;; esac; return 1; }

# Launch a GUI app so it OUTLIVES us. The watcher runs as a transient systemd
# service, and a service's cgroup is killed when it exits -- taking any
# setsid-detached child with it, which is why an opened image vanished before
# it could map a window. uwsm-app puts the app in its own unit in app.slice,
# which is what the rest of Omarchy does (see omarchy-launch-browser).
launch() {
  # Synchronously, and NOT backgrounded: uwsm-app returns once the app has its
  # own unit, and we must still be alive at that moment. Backgrounding it and
  # exiting killed it in our cgroup before the handoff -- the app never
  # appeared, silently.
  if command -v uwsm-app >/dev/null 2>&1; then
    uwsm-app -- "$@" || echo "omdrop: uwsm-app could not launch: $*" >&2
  else
    systemd-run --user --quiet --collect "$@" \
      || echo "omdrop: could not launch: $*" >&2
  fi
}

act_open() {
  local f=$1
  if is_link_file "$f"; then cmd_open_link "$f"
  elif has_default_app "$f"; then launch xdg-open "$f"
  else reveal_in_files "$f"
  fi
}

# Whether xdg-open has an app registered for the file's type. Without one it
# falls back to the browser: imv registers image/heif but not image/heic, and
# Omarchy's defaults register nothing for it, so an iPhone photo opened Chrome.
# Without xdg-mime there is nothing to ask, and xdg-open keeps the file.
has_default_app() {
  command -v xdg-mime >/dev/null 2>&1 || return 0
  local type; type=$(xdg-mime query filetype "$1" 2>/dev/null)
  [[ -n "$type" && -n "$(xdg-mime query default "$type" 2>/dev/null)" ]]
}

# Show a received file in the file manager with it selected: the click's
# fallback when no app is registered for the file. Nautilus is Omarchy's file
# manager; anything else gets the folder through xdg-open, which never hands a
# file to the browser.
reveal_in_files() {
  local f=$1
  if command -v nautilus >/dev/null 2>&1; then launch nautilus --select "$f"
  else launch xdg-open "$(dirname "$f")"
  fi
}

# Previews live in the runtime dir: RAM, private to the user, and gone at
# logout, so they never become a second copy of every photo received. Only the
# last PREVIEW_KEEP stay -- enough for the toasts of a burst of photos to still
# find their image. In Everyone mode the file comes from anyone nearby and is
# decoded without a click, so each decode gets PREVIEW_TIMEOUT seconds.
PREVIEW_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omdrop/previews"
PREVIEW_KEEP=10
PREVIEW_SIZE=512
PREVIEW_TIMEOUT=${OMDROP_PREVIEW_TIMEOUT:-10}

# Run "$@" holding the per-user decode lock. Every arrival gets its own
# `handle`, so a burst of photos from a nearby sender would otherwise decode
# all at once, each at full size in RAM. omdrop-core takes the same lock file,
# so the two never decode together either. Each decode is bounded by its own
# timeout, so waiting for the lock is bounded too.
DECODE_LOCK="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omdrop/decode.lock"
with_decode_lock() {
  (umask 077 && mkdir -p -- "$(dirname "$DECODE_LOCK")") || return 1
  (
    umask 077
    exec 9>>"$DECODE_LOCK" && flock 9 || exit 1
    "$@"
  )
}

# Decode $1 into the preview $2 and shrink it: what heic_preview does under
# the decode lock.
decode_preview() {
  timeout -k 1 "$PREVIEW_TIMEOUT" heif-convert -q 80 "$1" "$2" >/dev/null 2>&1 \
    && [[ -s "$2" ]] || return 1
  shrink_preview "$2"
  return 0
}

# A small JPEG preview for formats the notification daemon cannot decode (HEIC
# from an iPhone). Prints the path of the preview, or nothing when none is
# possible; a failed or timed-out decode only costs the toast its thumbnail.
heic_preview() {
  local f=$1 work final
  command -v heif-convert >/dev/null 2>&1 || return 0
  (umask 077 && mkdir -p -- "$PREVIEW_DIR") || return 0
  # A unique name: IMG_1.heic and IMG_1.avif, or two arrivals with the same
  # name, each keep their own preview. Arrivals are handled in parallel, so a
  # preview is decoded and shrunk under working.*, and becomes preview.* --
  # the only name pruning looks at -- once it is complete.
  work=$(mktemp --suffix=.jpg "$PREVIEW_DIR/working.XXXXXX") || return 0
  final="$PREVIEW_DIR/preview.${work#"$PREVIEW_DIR/working."}"
  if with_decode_lock decode_preview "$f" "$work"; then
    # Pruning goes by when a preview was finished. A shrink that failed or
    # timed out leaves the decode's older time, and the newer previews of a
    # burst would prune this one before its toast could show it.
    touch -- "$work" 2>/dev/null
    mv -f -- "$work" "$final" || { rm -f -- "$work"; return 0; }
    prune_previews
    printf '%s\n' "$final"
  else
    # heif-convert names the images of a multi-image file out-1.jpg, out-2.jpg.
    rm -f -- "$work" "${work%.jpg}"-*.jpg
  fi
}

# heif-convert decodes at full size -- 4032x3024 for a 12 MP photo -- and the
# toast shows a few hundred pixels. ImageMagick scales it down when present;
# without it the full-size preview stays, still in RAM and still pruned.
shrink_preview() {
  local f=$1
  command -v magick >/dev/null 2>&1 || return 0
  if timeout -k 1 "$PREVIEW_TIMEOUT" magick "$f" -thumbnail "${PREVIEW_SIZE}x${PREVIEW_SIZE}>" \
       -quality 80 "jpg:$f.part" >/dev/null 2>&1 && [[ -s "$f.part" ]]; then
    mv -f -- "$f.part" "$f"
  else
    rm -f -- "$f.part"
  fi
}

# Keep the newest PREVIEW_KEEP finished previews and remove the rest. Files
# another arrival is still writing are named working.* and are left alone,
# unless a decode that was killed left one behind more than five minutes ago.
prune_previews() {
  find "$PREVIEW_DIR" -maxdepth 1 -type f -name 'preview.*.jpg' -printf '%T@ %p\n' 2>/dev/null \
    | sort -rn | tail -n +$((PREVIEW_KEEP + 1)) | cut -d' ' -f2- \
    | xargs -r -d '\n' rm -f --
  find "$PREVIEW_DIR" -maxdepth 1 -type f -name 'working.*' -mmin +5 -delete 2>/dev/null
}

# `open-link FILE`: open a link file's web page in the browser. The one entry
# point for both the notification's click and a double-click in the file
# manager, which reaches it through the desktop entry `links install` writes.
# A link that is not a web page is refused with a notification, because
# whoever double-clicked is looking at the file manager, not a terminal.
cmd_open_link() {
  local f=${1:?usage: omdrop open-link FILE} url raw why
  if url=$(link_target "$f"); then
    omarchy-launch-browser "$url" >/dev/null 2>&1
    return
  fi
  if raw=$(link_url "$f") && [[ "$raw" == *:* ]]; then
    why="It points to a ${raw%%:*}: address, and Omdrop opens only web links."
  else
    why="There is no web link in it."
  fi
  omarchy-notification-send "Can't open $(basename -- "$f")" "$why" >/dev/null 2>&1 \
    || echo "omdrop: can't open $f: $why" >&2
  return 1
}

# Double-clicking a received link file in the file manager. freedesktop
# already knows .url as application/x-mswinurl; .webloc is unknown to
# shared-mime-info (it detects as text/xml and opens in an editor), so it gets
# a type of its own, application/x-webloc, a name nothing installed claims.
LINK_APP=netmojo.omdrop-links.desktop
LINK_MIME=netmojo.omdrop-webloc.xml
LINK_TYPES=(application/x-mswinurl application/x-webloc)

data_home() { printf '%s' "${XDG_DATA_HOME:-$HOME/.local/share}"; }
mimeapps_list() { printf '%s' "${XDG_CONFIG_HOME:-$HOME/.config}/mimeapps.list"; }

# The default the user's own mimeapps.list names for a type, if any. Read
# directly rather than through `xdg-mime query default`, which also answers
# with any installed app that merely claims the type -- and only a default
# someone set is one to leave alone.
user_default() {
  local list; list=$(mimeapps_list)
  [[ -r "$list" ]] || return 0
  awk -v t="$1" '
    /^\[/ { in_defaults = ($0 == "[Default Applications]"); next }
    in_defaults && index($0, t "=") == 1 { v = substr($0, length(t) + 2); sub(/;.*/, "", v); print v; exit }
  ' "$list"
}

# An Exec path, quoted as the Desktop Entry spec requires: backslash before
# " ` $ and \ inside the quotes, every backslash doubled again because the
# value is a key-file string, and % doubled so it is not a field code.
desktop_exec_quote() {
  local s=$1
  s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//\`/\\\`}; s=${s//\$/\\\$}
  s=${s//\\/\\\\}; s=${s//%/%%}
  printf '"%s"' "$s"
}

# Write a file only when its content differs; succeeds only if it wrote.
write_if_changed() {
  local path=$1 content=$2
  [[ -r "$path" && "$(cat "$path")" == "$content" ]] && return 1
  mkdir -p "$(dirname "$path")" && printf '%s\n' "$content" > "$path"
}

# Install the handler; succeeds only if it changed anything, and says what.
links_install() {
  local plugin=$1 apps mime t current changed=1
  apps="$(data_home)/applications"; mime="$(data_home)/mime"
  if write_if_changed "$apps/$LINK_APP" "[Desktop Entry]
Type=Application
Name=Omdrop link opener
Comment=Open a link an Apple device sent over AirDrop in the web browser
Exec=$(desktop_exec_quote "$plugin/bin/omdrop") open-link %f
MimeType=application/x-mswinurl;application/x-webloc;
NoDisplay=true
Terminal=false"; then
    changed=0
    update-desktop-database "$apps" >/dev/null 2>&1 || true
  fi
  if write_if_changed "$mime/packages/$LINK_MIME" '<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-webloc">
    <comment>Website location</comment>
    <glob pattern="*.webloc"/>
  </mime-type>
</mime-info>'; then
    changed=0
    update-mime-database "$mime" >/dev/null 2>&1 \
      || echo "omdrop: update-mime-database failed, so .webloc files may still open as XML." >&2
  fi
  for t in "${LINK_TYPES[@]}"; do
    current=$(user_default "$t")
    if [[ -z "$current" ]]; then
      # xdg-mime cannot create the folder, and exits 0 when it fails, so
      # make the folder first and check the result afterwards.
      mkdir -p "$(dirname "$(mimeapps_list)")"
      xdg-mime default "$LINK_APP" "$t" >/dev/null 2>&1
      if [[ "$(user_default "$t")" == "$LINK_APP" ]]; then changed=0
      else echo "omdrop: could not make Omdrop open $t files. Run: xdg-mime default $LINK_APP $t" >&2
      fi
    elif [[ "$current" != "$LINK_APP" ]]; then
      echo "Left $t opening with $current, which you chose. To open received links with Omdrop: xdg-mime default $LINK_APP $t" >&2
    fi
  done
  (( changed == 0 )) && echo "Set up double-clicking a received .url or .webloc link to open it in the browser."
  return "$changed"
}

# Reverse links_install. A default is removed only while it still names us,
# so a user who pointed a type elsewhere keeps their choice.
links_remove() {
  local apps mime list t
  apps="$(data_home)/applications"; mime="$(data_home)/mime"; list=$(mimeapps_list)
  for t in "${LINK_TYPES[@]}"; do
    [[ "$(user_default "$t")" == "$LINK_APP" && -w "$list" ]] || continue
    T="$t=" A="$LINK_APP" awk '
      /^\[/ { in_defaults = ($0 == "[Default Applications]") }
      in_defaults && ($0 == ENVIRON["T"] ENVIRON["A"] || $0 == ENVIRON["T"] ENVIRON["A"] ";") { next }
      { print }' "$list" > "$list.omdrop.$$" && mv -f "$list.omdrop.$$" "$list"
  done
  if [[ -e "$apps/$LINK_APP" ]]; then
    rm -f "$apps/$LINK_APP"
    update-desktop-database "$apps" >/dev/null 2>&1 || true
  fi
  if [[ -e "$mime/packages/$LINK_MIME" ]]; then
    rm -f "$mime/packages/$LINK_MIME"
    update-mime-database "$mime" >/dev/null 2>&1 || true
  fi
  echo "Removed the handler for received .url and .webloc links."
}

cmd_links() {
  case "${1:-}" in
    install) local plugin; plugin=$(plugin_dir) || die "omdrop cannot tell where it is installed."
             links_install "$plugin" || echo "The link handler was already set up." ;;
    remove)  links_remove ;;
    *) die "usage: omdrop links install|remove" ;;
  esac
}

# The skill that tells an AI agent how to use omdrop, linked into the skill
# directories Omarchy provisions for the agents it launches. Only directories
# that already exist: a missing one belongs to an agent that is not installed.
#
# Only `omdrop skill install` writes these links: never setup, never `on`. They
# put instructions into other programs' configuration, so they are the user's
# choice, and a removed skill stays removed.
SKILL_DIRS=("$HOME/.agents/skills" "$HOME/.claude/skills" "$HOME/.codex/skills" "$HOME/.pi/agent/skills")

# A one-line pointer from `omdrop setup`, when an agent is set up and the
# skill is not linked for it. It changes nothing.
skills_offer() {
  local dir
  for dir in "${SKILL_DIRS[@]}"; do
    if [[ -d "$dir" && ! -L "$dir/omdrop" && ! -e "$dir/omdrop" ]]; then
      printf 'To let AI agents use omdrop, run: omdrop skill install\n'
      return 0
    fi
  done
}

# An entry named omdrop is replaced only when it is absent, a dangling link,
# or a link into some plugin's skills/omdrop -- the same rule as the command
# on PATH. Judged by the link's own target, not its resolution: a plugin
# directory can itself be a link into a source checkout. Anything else, a
# directory or a live link elsewhere, is left in place with a message.
# Returns 0 when it linked anything, 1 when every entry was already current
# or left in place, and 2 when a link could not be made.
skills_install() {
  local plugin=$1 dir link raw changed=1 failed=0
  if [[ ! -r "$plugin/skills/omdrop/SKILL.md" ]]; then
    echo "omdrop could not find its skill at $plugin/skills/omdrop." >&2
    return 2
  fi
  for dir in "${SKILL_DIRS[@]}"; do
    [[ -d "$dir" ]] || continue
    link="$dir/omdrop"
    if [[ -L "$link" ]]; then
      raw=$(readlink "$link")
      [[ "$raw" == "$plugin/skills/omdrop" ]] && continue
      if [[ -e "$link" && "$raw" != */plugins/*/skills/omdrop ]]; then
        echo "Left $link alone: it points at $raw." >&2
        continue
      fi
    elif [[ -e "$link" ]]; then
      echo "Left $link alone: it is not a link omdrop made." >&2
      continue
    fi
    if ln -sfn "$plugin/skills/omdrop" "$link"; then
      changed=0
    else
      echo "omdrop could not link its skill at $link." >&2
      failed=1
    fi
  done
  (( changed == 0 )) && echo "Installed the omdrop skill for AI agents."
  (( failed )) && return 2
  return "$changed"
}

# Removes only links into some plugin's skills/omdrop or this one's, live or
# dangling. Fails if any of those could not be removed.
skills_remove() {
  local dir link raw plugin failed=0
  plugin=$(plugin_dir) || plugin=
  for dir in "${SKILL_DIRS[@]}"; do
    link="$dir/omdrop"
    [[ -L "$link" ]] || continue
    raw=$(readlink "$link")
    [[ "$raw" == */plugins/*/skills/omdrop || ( -n "$plugin" && "$raw" == "$plugin/skills/omdrop" ) ]] || continue
    rm -f "$link" || { echo "omdrop could not remove $link." >&2; failed=1; }
  done
  (( failed )) && return 1
  echo "Removed the omdrop skill for AI agents."
}

cmd_skill() {
  local plugin rc
  case "${1:-}" in
    install) plugin=$(plugin_dir) || die "omdrop cannot tell where it is installed."
             skills_install "$plugin"; rc=$?
             (( rc == 1 )) && echo "The omdrop skill for AI agents was already installed."
             (( rc != 2 )) ;;
    remove)  skills_remove ;;
    *) die "usage: omdrop skill install|remove" ;;
  esac
}

# A received link is a URL chosen by whoever is standing nearby, and while
# discoverable to Everyone that is a one-tap phishing delivery. The receiver
# stores links inert; nothing here opens one on its own. act_open exists only
# behind a click the user made on the notification.

# Put the arrival on the clipboard as well as announcing it: a link as its URL,
# an image as the image itself, anything else as its path. wl-copy forks a
# server to own the selection, so it has to survive us -- launch() gives it its
# own unit, the same reason the viewer needed one.
#
# HEIC/HEIF/AVIF (what an iPhone sends since 0.16.0) is not a type anything
# pastes, so it is decoded once to a JPEG and that goes on the clipboard (#62).
# Any failure -- no heif-convert, a timeout, a nonzero exit, no output -- falls
# back to copying the path, as before. The original is never touched.
copy_to_clipboard() {
  local f=$1 url tmp; url=$(link_target "$f")
  command -v wl-copy >/dev/null 2>&1 || return 0
  if [[ -n "$url" ]]; then
    printf '%s' "$url" | launch wl-copy
    return
  fi
  case "${f,,}" in
    *.png)  launch wl-copy --type image/png  < "$f" ;;
    *.jpg|*.jpeg) launch wl-copy --type image/jpeg < "$f" ;;
    *.gif)  launch wl-copy --type image/gif  < "$f" ;;
    *.webp) launch wl-copy --type image/webp < "$f" ;;
    *.heic|*.heif|*.avif)
      if tmp=$(heif_to_jpeg "$f"); then
        # The redirect holds the JPEG open for wl-copy, so removing the
        # directory afterwards is safe and leaves nothing behind.
        launch wl-copy --type image/jpeg < "$tmp/clip.jpg"
        rm -rf -- "$tmp"
      else
        printf '%s' "$f" | launch wl-copy
      fi ;;
    *)      printf '%s' "$f" | launch wl-copy ;;
  esac
}

# Decode a HEIC/HEIF/AVIF into a private 0700 directory, unique to this
# arrival, under the runtime dir; print the directory, which holds clip.jpg.
# A directory rather than a file because heif-convert can write extra images
# (aux, depth) beside its output, and the caller removes it whole. On failure
# print nothing, leave nothing, return 1.
#
# The file came from whoever was nearby, so the decode is time-limited:
# 10 s. A 48 MP iPhone photo decodes in a second or two even on modest
# hardware, so this never cuts off a real photo, but it bounds a hostile file
# built to stall the handler. It runs under the decode lock, one at a time.
HEIF_TIMEOUT=10
heif_to_jpeg() {
  local src=$1 base tmp
  command -v heif-convert >/dev/null 2>&1 || return 1
  base="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omdrop"
  (umask 077 && mkdir -p -- "$base") || return 1
  tmp=$(mktemp -d "$base/clip.XXXXXX") || return 1
  if with_decode_lock timeout -k 2 "$HEIF_TIMEOUT" heif-convert -q 90 "$src" "$tmp/clip.jpg" </dev/null >/dev/null 2>&1 \
     && [[ -s "$tmp/clip.jpg" ]]; then
    printf '%s' "$tmp"
    return 0
  fi
  rm -rf -- "$tmp"
  return 1
}

# A received file's name, for a toast. omarchy-notification-send reads options
# up to its headline and takes no `--`, so a name a sender chose, such as `-t`
# or `--app-name=Omarchy`, would be read as an option instead of shown. A name
# that starts with a dash is shown as ./NAME; every other name is unchanged.
toast_name() {
  local name=${1%/}
  name=${name##*/}
  [[ "$name" == -* ]] && name="./$name"
  printf '%s' "$name"
}

act_notify() {
  local f=$1 args=()
  copy_to_clipboard "$f"
  # Only images get a thumbnail, the way a screenshot notification does.
  case "${f,,}" in
    *.png|*.jpg|*.jpeg|*.gif|*.webp) args+=(--image "$f") ;;
    *.heic|*.heif|*.avif)
      local preview; preview=$(heic_preview "$f")
      [[ -n "$preview" ]] && args+=(--image "$preview") ;;
  esac
  # Same shape as omarchy-capture-screenshot: clipboard plus file, a thumbnail,
  # and the whole toast clickable. The notification service honours exactly one
  # action -- the default, fired by clicking the body -- and --exec is how
  # Omarchy's own toasts use it.
  #
  # -t 8000 is a deliberate number, not the default. The shell treats
  # expire_timeout as a FLOOR, not a ceiling: durationFor() is
  # max(lowPopupDuration=5000, requested) for low urgency, so the toast was
  # already holding 5.1 s (measured off NotificationClosed, reason 1) and
  # asking for 5000 would have changed nothing. This toast is the only place
  # the name of what landed appears, and the only thing to click to open it,
  # so it gets 8 s -- what a normal-urgency toast would get -- without
  # claiming the urgency of one.
  local what="Saved to $(tildify "$(dirname -- "$f")")/"
  command -v wl-copy >/dev/null 2>&1 && what="Copied to clipboard, saved to $(tildify "$(dirname -- "$f")")/"
  omarchy-notification-send -t 8000 "$(toast_name "$f")" "$what (or click this)" \
    "${args[@]}" --exec "$SELF" act open "$f" >/dev/null \
    || echo "omdrop: notification failed for $f" >&2
}

# What to do with a file once the user has asked for it: `act open` is what the
# notification fires when clicked, and shell/browse are here for the terminal.
# Each goes through launch(), which keeps the app out of our cgroup.
cmd_act() {
  local what=${1:?usage: omdrop act open|shell|browse FILE} f=${2:?}
  local dir; dir=$(dirname "$f")
  case "$what" in
    open)   act_open "$f" ;;
    shell)  ( cd "$dir" && launch "$(omarchy-default-terminal)" ) ;;
    browse) launch xdg-open "$dir" ;;
    *) die "act $what: one of open, shell, browse" ;;
  esac
}

# One behaviour for every arrival: save, copy, announce. Opening is left to a
# click on the notification, so nothing runs on the user's behalf unasked.
cmd_handle() {
  local f=${1:?usage: omdrop handle FILE}
  act_notify "$f"
}

# Nautilus's chooser, or the desktop portal's where Nautilus is absent. Prints
# the chosen path; a cancel is exit 1 with nothing said, because closing the
# chooser is an answer, not an error. OMDROP_PICKER stands in for it the way
# OMDROP_SENDER does for the sender.
pick() {
  if [[ -n "${OMDROP_PICKER:-}" ]]; then "$OMDROP_PICKER" "$@"
  else python3 "$PROJ/bin/pick.py" "$@"
  fi
}

cmd_dir() {
  if (( $# == 0 )); then
    printf '%s\n' "$(effective_dir)"
    return
  fi
  local want
  if [[ "$1" == --pick ]]; then
    want=$(pick folder "$(effective_dir)" "Save received files to") || exit $?
  else
    want=${1/#\~/$HOME}
  fi
  local new
  [[ -d "$want" ]] || die "$want: not a directory (create it first)"
  new=$(readlink -f "$want")
  [[ -O "$new" ]] || die "$new: you do not own it; received files land here as you"
  local old; old=$(cfg_get download_dir)
  cfg_set download_dir "$new" || die "could not write $CONFIG"

  local dropin="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$UNIT.d"
  mkdir -p "$dropin"
  # An empty assignment resets the list the base unit set; without it a
  # drop-in only ADDS, leaving the old folder writable and listing it twice.
  { echo "# Written by omdrop. Declares exactly the paths the receiver may write."
    echo "[Service]"
    echo "ReadWritePaths="
    echo "ReadWritePaths=$new"
    echo "ReadWritePaths=%h/.omdrop"
    echo "ReadWritePaths=-%t/omdrop/debug"
  } > "$dropin/10-download-dir.conf"
  systemctl --user daemon-reload

  if receiving; then
    if ! systemctl --user restart "$UNIT"; then
      [[ -n "$old" ]] && cfg_set download_dir "$old"
      systemctl --user restart "$UNIT" >/dev/null 2>&1 || true
      die "the receiver refused $new, so it is still ${old:-the default}.
systemctl --user status $UNIT"
    fi
  fi
  printf 'Files will land in %s\n' "$new"
}

# The radar's sound effects. Off is remembered, so the panel is quiet from the
# first frame next time rather than pinging once before it reads the setting.
sound_on() { [[ "$(setting_get sound)" != off ]]; }

cmd_sound() {
  case "${1:-}" in
    "")  sound_on && echo on || echo off ;;
    on|off) setting_set sound "$1" ;;
    *) die "usage: omdrop sound [on|off]" ;;
  esac
}

# Where the file chooser opens for a send: the folder the last sent file came
# from, while it still exists, and the download folder otherwise.
send_start_dir() {
  local d; d=$(setting_get send_from)
  [[ -n "$d" && -d "$d" ]] && printf '%s\n' "$d" || effective_dir
}

# Contacts Only. The receiver reads these two files directly (see bin/contacts.py):
# visibility switches the mode, known-senders is the allow-list of identifiers.
CONTACTS_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omdrop"

cmd_limit() {
  if (( $# == 0 )); then
    printf '%s%%\n' "$(effective_limit)"
    return
  fi
  (( $# == 1 )) || die "usage: omdrop limit [PERCENT]"
  local new=$1 old
  [[ "$new" =~ ^[0-9]+$ ]] || die "limit: an integer from 1 to 90"
  new=$((10#$new))
  (( new >= 1 && new <= 90 )) || die "limit: an integer from 1 to 90"
  old=$(effective_limit)
  cfg_set max_receive_percent "$new" || die "could not write $CONFIG"
  if receiving && ! systemctl --user restart "$UNIT"; then
    cfg_set max_receive_percent "$old"
    systemctl --user restart "$UNIT" >/dev/null 2>&1 || true
    die "the receiver refused ${new}%, so the limit is still ${old}%.
systemctl --user status $UNIT"
  fi
  printf 'A transfer may use up to %s%% of currently free download-disk space.\n' "$new"
}


# How many senders the allow-list holds, ignoring comments and blank lines.
# Counted in one place because three callers had their own copy of this
# pipeline and `status` needed a fourth.
sender_count() {
  # `grep -c` prints 0 AND exits 1 on no match, so `$(grep -c … || echo 0)`
  # yields "0\n0" and every arithmetic use of it fails. Take the exit status,
  # not a second echo.
  local n
  n=$(grep -cvE '^\s*(#|$)' "$CONTACTS_DIR/known-senders" 2>/dev/null) || n=0
  printf '%s\n' "${n:-0}"
}

cmd_visibility() {
  local vis_file="$CONTACTS_DIR/visibility"
  if (( $# == 0 )); then
    printf '%s\n' "$([[ $(cat "$vis_file" 2>/dev/null) == contacts ]] && echo contacts || echo everyone)"
    return
  fi
  case "$1" in
    everyone) rm -f "$vis_file"
              printf 'Anyone nearby can send to this machine.\n' ;;
    contacts)
      local n; n=$(sender_count)
      mkdir -p "$CONTACTS_DIR"; printf 'contacts\n' > "$vis_file"
      printf 'Only known senders can send to this machine (%s listed).\n' "$n"
      (( n == 0 )) && printf 'The list is empty, so everything is refused. Add people with: omdrop senders add <email|phone>\n'
      ;;
    *) die "usage: omdrop visibility [everyone|contacts]" ;;
  esac
  receiving && systemctl --user restart "$UNIT" >/dev/null 2>&1 || true
}

# An Apple ID is an email address or a phone number, and the receiver matches
# nothing else: anything that is neither would sit in the list matching no one.
sender_id_valid() {
  local id=$1 digits
  if [[ "$id" == *@* ]]; then
    [[ "$id" =~ ^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$ ]]
    return
  fi
  [[ "$id" =~ ^[+0-9().[:space:]-]+$ ]] || return 1
  digits=${id//[^0-9]/}
  (( ${#digits} >= 7 && ${#digits} <= 15 ))
}

cmd_senders() {
  local f="$CONTACTS_DIR/known-senders"
  local sub=${1:-list}; shift || true
  case "$sub" in
    list)
      if [[ "${1:-}" == --json ]]; then
        # For the panel: the identifiers exactly as stored, so a row's remove
        # names the same line the file holds.
        grep -vE '^\s*(#|$)' "$f" 2>/dev/null \
          | python3 -c 'import json,sys; print(json.dumps([l.strip() for l in sys.stdin]))'
        return
      fi
      [[ -s "$f" ]] && grep -vE '^\s*(#|$)' "$f" || printf '(no known senders yet)\n' ;;
    add)
      (( $# )) || die "usage: omdrop senders add <email-or-phone> [...]"
      local id
      for id in "$@"; do
        sender_id_valid "$id" \
          || die "\"$id\" is not an email address or a phone number. Use the email or phone number of their Apple ID."
      done
      mkdir -p "$CONTACTS_DIR"; touch "$f"
      for id in "$@"; do
        grep -qxF "$id" "$f" 2>/dev/null || printf '%s\n' "$id" >> "$f"
      done
      printf 'Added. %s known now.\n' "$(sender_count)" ;;
    remove|rm)
      (( $# )) || die "usage: omdrop senders remove <email-or-phone> [...]"
      [[ -f "$f" ]] || die "no known-senders list yet"
      local id tmp; tmp=$(mktemp)
      cp "$f" "$tmp"
      for id in "$@"; do grep -vxF "$id" "$tmp" > "$tmp.n" && mv "$tmp.n" "$tmp"; done
      mv "$tmp" "$f"
      printf 'Removed. %s known now.\n' "$(sender_count)" ;;
    *) die "usage: omdrop senders [list|add <id>|remove <id>]" ;;
  esac
}

cmd_name() {
  if (( $# == 0 )); then
    printf '%s\n' "$(effective_name)"
    return
  fi
  local new=$1 old
  [[ -n "${new//[[:space:]]/}" ]] || die "The name can't be empty."
  (( ${#new} <= 63 )) || die "The name can be 63 characters at most; this one has ${#new}."
  [[ "$new" != *[/\\]* ]] || die "The name can't contain / or \\."
  [[ "$new" != *[[:cntrl:]]* ]] || die "The name can't contain control characters."
  old=$(cfg_get name)
  cfg_set name "$new" || die "could not write $CONFIG"
  if receiving; then
    # The receiver reads config.toml once, at start. Restart to pick it up --
    # and if it refuses the new name, put the old one back rather than leave a
    # dead receiver behind a config the user thinks took effect.
    if ! systemctl --user restart "$UNIT"; then
      cfg_set name "$old"
      systemctl --user restart "$UNIT" >/dev/null 2>&1 || true
      die "the receiver refused \"$new\", so it is still \"$old\".
systemctl --user status $UNIT"
    fi
  fi
  printf 'Macs will see "%s"\n' "$new"
}

# Aliases exist because the words are guessable but not memorable: someone who
# has used systemctl reaches for start/stop, and someone who has used a peer
# tool reaches for list. Accepting the near-miss costs one word here and saves
# a person re-reading the help to learn a synonym we could simply have taken.
changes_panel "${1:-}" && trap panel_refresh EXIT
case "${1:-status}" in
  on|start)   shift; cmd_on "$@" ;;
  off|stop)   shift; cmd_off "$@" ;;
  toggle) shift; cmd_toggle "$@" ;;
  status) shift; cmd_status "$@" ;;
  send)   shift; cmd_send "$@" ;;
  peers|list) shift; cmd_peers "$@" ;;
  name)   shift; cmd_name "$@" ;;
  dir)    shift; cmd_dir "$@" ;;
  sound)  shift; cmd_sound "$@" ;;
  limit)  shift; cmd_limit "$@" ;;
  visibility|vis|viz) shift; cmd_visibility "$@" ;;
  senders) shift; cmd_senders "$@" ;;
  identity) shift; cmd_identity "$@" ;;
  setup)  shift; cmd_setup "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  links)  shift; cmd_links "$@" ;;
  skill|skills) shift; cmd_skill "$@" ;;
  open-link) shift; cmd_open_link "$@" ;;
  install-driver) shift; cmd_install_driver ;;
  install-core) shift; cmd_install_core ;;
  firewall) shift; cmd_firewall "$@" ;;
  act)    shift; cmd_act "$@" ;;
  watch)  shift; cmd_watch "$@" ;;
  handle) shift; cmd_handle "$@" ;;
  -V|--version|version) printf 'omdrop %s\n' "$(omdrop_version)" ;;
  -h|--help|help) usage ;;
  *)      usage >&2; exit 1 ;;
esac
